            "build_consumer",
            "cache_keys"
          ],
          [
            "build_consumer",
            "cache"
          ],
          [
            "build_consumer",
            "controls"
          ],
          [
            "build_consumer",
            "budgets"
          ]
        ]
      }
    },
    {
      "name": "matter-asset-pipeline",
      "component": "asset_pipeline",
      "source": "libs/AssetPipeline",
      "targets": [
        "matter_asset_archive",
        "matter_asset_surface",
        "matter_asset_surface_native",
        "matter_asset_prepared",
        "matter_asset_storage",
        "matter_asset_gltf",
        "matter_asset_legacy",
        "matter_asset_lod_kernels",
        "matter_asset_lod"
      ],
      "public_targets": [
        "matter_asset_archive",
        "matter_asset_surface",
        "matter_asset_surface_native",
        "matter_asset_prepared",
        "matter_asset_storage",
        "matter_asset_gltf",
        "matter_asset_legacy",
        "matter_asset_lod"
      ],
      "aggregate": "matter_asset_pipeline",
