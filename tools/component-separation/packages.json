              "MATTER_ASSET_STORAGE=1",
              "MATTER_ASSET_GLTF=1",
              "MATTER_ASSET_LEGACY=1",
              "MATTER_ASSET_LOD=1"
            ]
          }
        ],
        "runs": [
          [
            "asset_pipeline_consumer",
            "archive"
          ],
          [
            "asset_pipeline_consumer",
            "prepared"
          ],
          [
            "asset_pipeline_consumer",
            "cache_settings"
          ],
          [
            "asset_pipeline_consumer",
            "lod"
          ],
          [
            "asset_pipeline_consumer",
            "lod_failures"
          ],
          [
            "asset_pipeline_consumer",
            "storage"
          ],
          [
            "asset_pipeline_consumer",
            "gltf"
          ],
          [
            "asset_pipeline_consumer",
            "external"
          ],
          [
            "asset_pipeline_consumer",
            "malformed"
          ],
          [
            "asset_pipeline_consumer",
            "materials"
          ],
          [
            "asset_pipeline_consumer",
            "legacy"
          ]
        ]
      }
    },
    {
