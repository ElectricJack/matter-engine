{
  "schema": "matter.component-packages.v1",
  "description": "Local redistributable packages for the audited components. package_components.py builds each native package standalone from its source directory, stages only its own archives and public headers, and rejects a package whose third-party inputs, cross-package links or notices disagree with this file or rules.json. Nothing here is published to a registry.",
  "notices": {
    "raylib": {
      "path": "third_party/raylib/LICENSE",
      "mode": "full",
      "covers": [
        "third_party/raylib/src/raylib.h"
      ],
      "note": "header only: POD Vector/Mesh declarations read by in-place MatterSurfaceLib sources; no raylib code is linked"
    },
    "stb_image": {
      "path": "third_party/raylib/src/external/stb_image.h",
      "mode": "stb_mit",
      "covers": [
        "third_party/raylib/src/external/stb_image.h"
      ]
    },
    "stb_image_write": {
      "path": "third_party/raylib/src/external/stb_image_write.h",
      "mode": "stb_mit",
      "covers": [
        "third_party/raylib/src/external/stb_image_write.h"
      ]
    },
    "quickjs_ng": {
      "stager": "quickjs_ng",
      "covers": [
        "third_party/quickjs-ng/"
      ]
    },
    "vulkan_headers": {
      "stager": "vulkan_headers",
      "covers": [
        "third_party/Vulkan-Headers/"
      ]
    },
    "three": {
      "path": "integrations/web-procedural/viewer/vendor/three/LICENSE",
      "mode": "full",
      "covers": [
        "vendor/three/"
      ]
    },
    "emscripten": {
      "sdk": "upstream/emscripten/LICENSE",
      "mode": "full",
      "covers": [
        "emscripten runtime"
      ]
    },
    "musl": {
      "sdk": "upstream/emscripten/system/lib/libc/musl/COPYRIGHT",
      "mode": "full",
      "covers": [
        "libc"
      ]
    },
    "libcxx": {
      "sdk": "upstream/emscripten/system/lib/libcxx/LICENSE.TXT",
      "mode": "full",
      "covers": [
        "libc++"
      ]
    },
    "libcxxabi": {
      "sdk": "upstream/emscripten/system/lib/libcxxabi/LICENSE.TXT",
      "mode": "full",
      "covers": [
        "libc++abi"
      ]
    },
    "compiler_rt": {
      "sdk": "upstream/emscripten/system/lib/compiler-rt/LICENSE.TXT",
      "mode": "full",
      "covers": [
        "compiler-rt"
      ]
    }
  },
  "native": [
    {
      "name": "matter-contracts",
      "component": "contracts",
      "source": "libs/MatterContracts",
      "targets": [
        "matter_contracts"
      ],
      "public_targets": [
        "matter_contracts"
      ],
      "include_dirs": [
        "libs/MatterContracts/include",
        "libs/MathLib/include"
      ],
      "docs": [
        "libs/MatterContracts/README.md",
        "libs/MatterContracts/SERVICES.md"
      ],
      "examples": [
        "libs/MatterContracts/examples/ordered-csg.recipe.json",
        "libs/MatterContracts/examples/repeated-assembly.asset.json",
        "libs/MatterContracts/examples/contracts.mjs"
      ],
      "notices": [],
      "consumer": {
        "programs": [
          {
            "name": "contracts_consumer",
            "sources": [
              "libs/MatterContracts/tests/contracts_tests.cpp"
            ],
            "links": [
              "matter::contracts"
            ],
            "headers": [
              "libs/MatterContracts/tests/fixtures.h"
            ]
          }
        ],
        "runs": [
          [
            "contracts_consumer"
          ]
        ]
      }
    },
    {
      "name": "matter-geometry",
      "component": "geometry",
      "source": "libs/ProceduralGeometry",
      "targets": [
        "matter_geometry",
        "matter_geometry_field"
      ],
      "public_targets": [
        "matter_geometry",
        "matter_geometry_field"
      ],
      "include_dirs": [
        "libs/ProceduralGeometry/include"
      ],
      "docs": [
        "libs/ProceduralGeometry/README.md"
      ],
      "examples": [
        "libs/ProceduralGeometry/examples/direct_recipe.cpp"
      ],
      "notices": [
        "raylib"
      ],
      "consumer": {
        "programs": [
          {
            "name": "geometry_consumer",
            "sources": [
              "libs/ProceduralGeometry/examples/direct_recipe.cpp"
            ],
            "links": [
              "matter::geometry"
            ]
          }
        ],
        "runs": [
          [
            "geometry_consumer"
          ]
        ]
      }
    },
    {
      "name": "matter-geometry-c",
      "component": "geometry_c",
      "source": "bindings/geometry-c",
      "targets": [
        "matter_geometry_c"
      ],
      "public_targets": [
        "matter_geometry_c"
      ],
      "include_dirs": [
        "bindings/geometry-c/include"
      ],
      "docs": [
        "bindings/geometry-c/README.md"
      ],
      "examples": [
        "bindings/geometry-c/tests/consumer.c",
        "bindings/geometry-c/tests/requests.json",
        "bindings/geometry-c/tests/Fixtures.cmake"
      ],
      "notices": [],
      "consumer": {
        "programs": [
          {
            "name": "geometry_c_consumer",
            "sources": [
              "bindings/geometry-c/tests/consumer.c"
            ],
            "links": [
              "matter::geometry_c"
            ],
            "copy": [
              "bindings/geometry-c/tests/requests.json"
            ],
            "c_standard": 11
          }
        ],
        "runs": [
          [
            "geometry_c_consumer"
          ]
        ],
        "cmake_include": "bindings/geometry-c/tests/Fixtures.cmake"
      }
    },
    {
      "name": "matter-terrain",
      "component": "terrain",
      "source": "libs/TerrainGeneration",
      "version": "0.1.0",
      "cmake": {
        "MATTER_TERRAIN_BUILD_EXAMPLES": "OFF"
      },
      "targets": [
        "matter_terrain"
      ],
      "public_targets": [
        "matter_terrain"
      ],
      "include_dirs": [
        "libs/TerrainGeneration/include"
      ],
      "docs": [
        "libs/TerrainGeneration/README.md"
      ],
      "examples": [
        "libs/TerrainGeneration/tests/examples/terrain_headless_tool.cpp",
        "libs/TerrainGeneration/tests/examples/terrain_product_consumer.cpp",
        "libs/TerrainGeneration/tests/examples/terrain_example_tiles.h"
      ],
      "notices": [],
      "consumer": {
        "programs": [
          {
            "name": "terrain_tool",
            "sources": [
              "libs/TerrainGeneration/tests/examples/terrain_headless_tool.cpp"
            ],
            "headers": [
              "libs/TerrainGeneration/tests/examples/terrain_example_tiles.h"
            ],
            "links": [
              "matter::terrain"
            ]
          },
          {
            "name": "terrain_consumer",
            "sources": [
              "libs/TerrainGeneration/tests/examples/terrain_product_consumer.cpp"
            ],
            "links": [
              "matter::contracts"
            ]
          }
        ],
        "runs": [
          [
            "terrain_tool",
            "{work}/terrain-package"
          ],
          [
            "terrain_consumer",
            "{work}/terrain-package"
          ]
        ]
      }
    },
    {
      "name": "matter-build",
      "component": "build",
      "source": "libs/ProceduralBuild",
      "version": "0.1.0",
      "targets": [
        "matter_build"
      ],
      "public_targets": [
        "matter_build"
      ],
      "include_dirs": [
        "libs/ProceduralBuild/include"
      ],
      "docs": [
        "libs/ProceduralBuild/README.md"
      ],
      "examples": [],
