file(READ "${BUILD}/compute-dependencies.txt" links)
if(NOT links STREQUAL "matter_contracts\nmatter_compute_device\n")
    message(FATAL_ERROR "Unexpected compute dependencies: ${links}")
endif()
file(GLOB_RECURSE sources "${SOURCE}/../ComputeDevice/src/*" "${SOURCE}/../ComputeDevice/include/*")
foreach(source IN LISTS sources)
    file(READ "${source}" text)
    if(text MATCHES "#include[^\n]*(graphics|render/|geometry|world|GLFW|quickjs|dsl_state)")
        message(FATAL_ERROR "Upward dependency in neutral device: ${source}")
    endif()
endforeach()
file(READ "${BUILD}/build.ninja" graph)
if(graph MATCHES "vk_context.cpp|vk_scene_renderer.cpp|script_host.cpp|dsl_state.cpp|glfw|matter_graphics|matter_terrain")
    message(FATAL_ERROR "Compute executable acquired scene/host/terrain dependencies")
endif()
