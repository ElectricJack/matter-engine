cmake_minimum_required(VERSION 3.25)
file(READ "${LINKS}" links)
if(NOT links STREQUAL "matter_contracts\nmatter_compute_device\n")
    message(FATAL_ERROR "Unexpected compute dependencies: ${links}")
endif()
file(GLOB_RECURSE sources "${SOURCE}/../ComputeDevice/src/*" "${SOURCE}/../ComputeDevice/include/*")
foreach(source IN LISTS sources)
    file(READ "${source}" text)
    if(text MATCHES "#include[^\n]*(graphics|render/|geometry|world|GLFW|quickjs|dsl_state)")
        message(FATAL_ERROR "Upward dependency in neutral device: ${source}")
    endif()
endforeach()
# The file-api reply is available only after generation. Walk the actual
# executable dependency closure for the selected configuration, including
# source paths and linker fragments (which also expose imported libraries).
if(NINJA)
    execute_process(COMMAND "${NINJA}" -C "${BUILD}" -t graph matter_geometry_compute_tests
        RESULT_VARIABLE result OUTPUT_VARIABLE graph ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot read generated compute graph: ${error}")
    endif()
    if(graph MATCHES "vk_context.cpp|vk_scene_renderer.cpp|script_host.cpp|dsl_state.cpp|glfw|matter_graphics|matter_terrain")
        message(FATAL_ERROR "Compute executable acquired scene/host/terrain dependencies")
    endif()
    message(STATUS "Compute direct-link, neutral-source and generated-graph qualification passed")
    return()
endif()
set(reply "${BUILD}/.cmake/api/v1/reply")
file(GLOB indices "${reply}/index-*.json")
if(NOT indices)
    message(FATAL_ERROR "Missing generated compute dependency graph")
endif()
list(SORT indices)
list(GET indices -1 index)
file(READ "${index}" index_json)
string(JSON model_file GET "${index_json}" reply codemodel-v2 jsonFile)
file(READ "${reply}/${model_file}" model)
string(JSON configs LENGTH "${model}" configurations)
math(EXPR last_config "${configs} - 1")
set(selected FALSE)
foreach(c RANGE ${last_config})
    string(JSON name GET "${model}" configurations ${c} name)
    if(NOT name STREQUAL CONFIG)
        continue()
    endif()
    set(selected TRUE)
    string(JSON count LENGTH "${model}" configurations ${c} targets)
    math(EXPR last_target "${count} - 1")
    set(pending)
    foreach(t RANGE ${last_target})
        string(JSON name GET "${model}" configurations ${c} targets ${t} name)
        string(JSON id GET "${model}" configurations ${c} targets ${t} id)
        string(JSON target_file GET "${model}" configurations ${c} targets ${t} jsonFile)
        set("target_${id}" "${target_file}")
        if(name STREQUAL "matter_geometry_compute_tests")
            list(APPEND pending "${id}")
        endif()
    endforeach()
    if(NOT pending)
        message(FATAL_ERROR "Compute test executable missing from generated graph")
    endif()
    set(visited)
    while(pending)
        list(POP_FRONT pending id)
        if(id IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${id}")
        file(READ "${reply}/${target_${id}}" target)
        # JSON paths may contain escaped backslashes on native Windows.
        string(REPLACE "\\" "/" normalized "${target}")
        if(normalized MATCHES "vk_context.cpp|vk_scene_renderer.cpp|script_host.cpp|dsl_state.cpp|glfw|matter_graphics|matter_terrain")
            message(FATAL_ERROR "Compute executable acquired scene/host/terrain dependencies: ${id}")
        endif()
        string(JSON dependencies ERROR_VARIABLE error LENGTH "${target}" dependencies)
        if(NOT error AND dependencies GREATER 0)
            math(EXPR last_dependency "${dependencies} - 1")
            foreach(d RANGE ${last_dependency})
                string(JSON dependency GET "${target}" dependencies ${d} id)
                list(APPEND pending "${dependency}")
            endforeach()
        endif()
    endwhile()
endforeach()
if(NOT selected)
    message(FATAL_ERROR "Configuration '${CONFIG}' missing from generated compute graph")
endif()
message(STATUS "Compute direct-link, neutral-source and generated-graph qualification passed")
