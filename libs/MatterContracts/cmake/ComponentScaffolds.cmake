include_guard(GLOBAL)
get_filename_component(_matter_scaffold_root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
# Directory-scoped variable can be shadowed by callers; the immutable global
# property also makes registration work from a sibling local build file.
set_property(GLOBAL PROPERTY MATTER_SCAFFOLD_ROOT "${_matter_scaffold_root}")
function(matter_register_component component)
    if(NOT TARGET ${component})
        get_property(_matter_scaffold_root GLOBAL PROPERTY MATTER_SCAFFOLD_ROOT)
        if(component STREQUAL "matter_contracts")
            add_subdirectory("${_matter_scaffold_root}/libs/MatterContracts" "${CMAKE_BINARY_DIR}/matter-components/matter_contracts")
        elseif(component STREQUAL "matter_geometry")
            add_subdirectory("${_matter_scaffold_root}/libs/ProceduralGeometry" "${CMAKE_BINARY_DIR}/matter-components/matter_geometry")
        elseif(component STREQUAL "matter_build")
            add_subdirectory("${_matter_scaffold_root}/libs/ProceduralBuild" "${CMAKE_BINARY_DIR}/matter-components/matter_build")
        elseif(component STREQUAL "matter_graphics")
            add_subdirectory("${_matter_scaffold_root}/libs/MatterGraphics" "${CMAKE_BINARY_DIR}/matter-components/matter_graphics")
        elseif(component STREQUAL "matter_terrain")
            add_subdirectory("${_matter_scaffold_root}/libs/TerrainGeneration" "${CMAKE_BINARY_DIR}/matter-components/matter_terrain")
        elseif(component STREQUAL "matter_asset_pipeline")
            add_subdirectory("${_matter_scaffold_root}/libs/AssetPipeline" "${CMAKE_BINARY_DIR}/matter-components/matter_asset_pipeline")
        elseif(component STREQUAL "matter_geometry_c")
            add_subdirectory("${_matter_scaffold_root}/bindings/geometry-c" "${CMAKE_BINARY_DIR}/matter-components/matter_geometry_c")
        elseif(component STREQUAL "matter_host_quickjs")
            add_subdirectory("${_matter_scaffold_root}/MatterEngine3/src/script/portable_host" "${CMAKE_BINARY_DIR}/matter-components/matter_host_quickjs")
        else()
            message(FATAL_ERROR "Unknown Matter component: ${component}")
        endif()
    endif()
endfunction()

function(matter_write_component_graph path)
    get_property(components GLOBAL PROPERTY MATTER_SCAFFOLD_TARGETS)
    set(graph "matter_contracts|implemented|\n")
    foreach(component IN LISTS components)
        get_target_property(dependencies ${component} INTERFACE_LINK_LIBRARIES)
        string(JOIN "," dependencies ${dependencies})
        string(APPEND graph "${component}|scaffold|${dependencies}\n")
    endforeach()
    file(WRITE "${path}" "${graph}")
endfunction()
