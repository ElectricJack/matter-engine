include("${GRAPH}")
if(NOT terrain_links STREQUAL "matter_contracts;matter_geometry_field" OR
   NOT terrain_public_links STREQUAL "matter_contracts;$<LINK_ONLY:matter_geometry_field>")
    message(FATAL_ERROR "Terrain acquired a library outside the contracts/geometry boundary")
endif()
set(expected_sources src/field.cpp src/meshing.cpp src/terrain_mesher.cpp)
if(NOT terrain_sources STREQUAL expected_sources)
    message(FATAL_ERROR "Terrain source set changed: review algorithm ownership and independence")
endif()
foreach(header field meshing)
    file(READ "${module_root}/include/matter/terrain/${header}.h" source)
    if(source MATCHES "#include[^\n]*(terrain_field|terrain_mesher|raylib|quickjs|vulkan|world_state|sector_streamer)")
        message(FATAL_ERROR "Non-neutral dependency leaked through the public terrain interface")
    endif()
endforeach()
if(msvc)
    execute_process(COMMAND "${symbol_tool}" /dump /symbols "${archive}"
        RESULT_VARIABLE status OUTPUT_VARIABLE symbols ERROR_VARIABLE errors)
else()
    execute_process(COMMAND "${symbol_tool}" -C "${archive}"
        RESULT_VARIABLE status OUTPUT_VARIABLE symbols ERROR_VARIABLE errors)
endif()
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot audit terrain archive: ${errors}")
endif()
if(symbols MATCHES "JS_Eval|vkCreate|SectorStreamer|WorldSession|vk_scene_renderer|BeginDrawing")
    message(FATAL_ERROR "Terrain archive contains a host, world coordinator or GPU backend")
endif()
message(STATUS "TERRAIN-INDEPENDENT: contracts+geometry link, original CPU sources, no renderer/host/world symbols")
