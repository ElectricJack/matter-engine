# Regenerates the example package into SECOND and requires every emitted file
# to match FIRST byte for byte: identities in the README must be reproducible.
execute_process(COMMAND "${TOOL}" "${SECOND}" RESULT_VARIABLE status OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Second generation failed (${status}): ${errors}")
endif()
file(GLOB_RECURSE first RELATIVE "${FIRST}" "${FIRST}/*")
file(GLOB_RECURSE second RELATIVE "${SECOND}" "${SECOND}/*")
list(SORT first)
list(SORT second)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "Package file sets differ:\n${first}\n${second}")
endif()
foreach(path IN LISTS first)
    file(SHA256 "${FIRST}/${path}" a)
    file(SHA256 "${SECOND}/${path}" b)
    if(NOT a STREQUAL b)
        message(FATAL_ERROR "Package file ${path} is not reproducible: ${a} vs ${b}")
    endif()
endforeach()
list(LENGTH first count)
file(SHA256 "${FIRST}/manifest.json" manifest)
message(STATUS "REPRODUCIBLE: ${count} files, manifest sha256=${manifest}")
