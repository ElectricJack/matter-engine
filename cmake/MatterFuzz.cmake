include_guard(GLOBAL)
option(MATTER_BUILD_FUZZERS "Build opt-in longer fuzz drivers (not registered with CTest)" OFF)
option(MATTER_FUZZ_LIBFUZZER "Use Clang libFuzzer instead of the seeded standalone driver" OFF)
function(matter_add_fuzzer name source library)
    if(NOT MATTER_BUILD_FUZZERS)
        return()
    endif()
    if(EMSCRIPTEN)
        message(FATAL_ERROR "Long fuzz drivers are native; WASM uses the seeded CTest properties")
    endif()
    add_executable(${name} "${source}")
    target_link_libraries(${name} PRIVATE ${library})
    target_compile_definitions(${name} PRIVATE MATTER_FUZZ_DRIVER=1)
    if(MATTER_FUZZ_LIBFUZZER)
        if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
            message(FATAL_ERROR "MATTER_FUZZ_LIBFUZZER requires Clang")
        endif()
        # Instrument libraries too: -fsanitize=fuzzer on just a driver would
        # leave the implementation invisible to coverage-guided mutation.
        # The caller supplies fuzzer-no-link plus ASan/UBSan in global flags.
        if(NOT CMAKE_CXX_FLAGS MATCHES "fsanitize=[^ ]*fuzzer-no-link" OR
           NOT CMAKE_C_FLAGS MATCHES "fsanitize=[^ ]*fuzzer-no-link")
            message(FATAL_ERROR "Set CMAKE_C_FLAGS and CMAKE_CXX_FLAGS to -fsanitize=fuzzer-no-link,address,undefined for library coverage")
        endif()
        target_compile_options(${name} PRIVATE -fsanitize=fuzzer)
        target_link_options(${name} PRIVATE -fsanitize=fuzzer)
    else()
        target_sources(${name} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/fuzz/standalone.cpp")
    endif()
endfunction()
