{
  "version": 1,
  "groups": {
    "viewer.budget": { "pixel_budget": 4 },
    "render.gpu": { "ray_tracing": true },
    "render.lighting": {
      "sun_azimuth_deg": -145,
      "sun_elevation_deg": 42,
      "sun_multiplier": 1.5,
      "sky_multiplier": 0.65,
      "sun_tint": [1, 0.94, 0.84],
      "sky_tint": [1, 0.9, 0.7],
      "day_ambient_multiplier": 0.2,
      "sky_irradiance_multiplier": 0.3,
      "exposure_ev": 0.1,
      "sun_shadow_samples": 3,
      "sun_angular_diameter_deg": 1.2
    }
  }
}
