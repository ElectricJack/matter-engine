  "budgets": [
    {
      "id": "BUDGET-NODES",
      "kind": "recipe",
      "input": "fixtures/ordered-csg.recipe.json",
      "limit": "max_nodes",
      "value": 2,
      "expected_code": "resource_limit"
    },
    {
      "id": "BUDGET-VERTICES",
      "kind": "asset",
      "input": "fixtures/cube.asset.json",
      "limit": "max_vertices",
      "value": 7,
      "expected_code": "resource_limit"
    },
    {
      "id": "BUDGET-INDICES",
      "kind": "asset",
      "input": "fixtures/cube.asset.json",
      "limit": "max_indices",
      "value": 35,
      "expected_code": "resource_limit"
    },
    {
      "id": "BUDGET-JSON",
      "kind": "json",
      "input": "fixtures/primitive.recipe.json",
      "limit": "max_value_nodes",
      "value": 2,
      "expected_code": "resource_limit"
    }
