      "expected_publish": false
    },
    {
      "id": "ERROR-INVALID-INDEX",
      "kind": "asset",
      "input": "fixtures/invalid-index.asset.json",
      "expected_code": "invalid_input",
      "expected_publish": false
    },
    {
      "id": "ERROR-SINGULAR-TRANSFORM",
      "kind": "asset",
      "input": "fixtures/singular-transform.asset.json",
      "expected_code": "invalid_input",
      "expected_publish": false
    },
    {
      "id": "ERROR-CSG-NONUNIFORM",
      "kind": "recipe",
      "input": "fixtures/csg-nonuniform.recipe.json",
