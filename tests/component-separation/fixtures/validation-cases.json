      "expected_code": "missing_dependency",
      "expected_publish": false
    },
    {
      "id": "ERROR-CYCLE",
      "kind": "recipe",
      "input": "fixtures/cycle.recipe.json",
      "expected_code": "cycle",
      "expected_publish": false
    },
    {
      "id": "ERROR-UNKNOWN-REQUIRED",
      "kind": "recipe",
      "input": "fixtures/unknown-required.recipe.json",
      "expected_code": "unsupported_capability",
      "expected_publish": false
    },
    {
      "id": "ERROR-UNSUPPORTED-VERSION",
      "kind": "recipe",
      "input": "fixtures/unsupported-version.recipe.json",
      "expected_code": "unsupported_version",
      "expected_publish": false
    },
    {
      "id": "ERROR-NEGATIVE-SIZE",
      "kind": "recipe",
      "input": "fixtures/negative-size.recipe.json",
