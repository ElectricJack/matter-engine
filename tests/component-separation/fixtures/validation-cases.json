      "expected_publish": false
    },
    {
      "id": "ERROR-DUPLICATE-KEY",
      "kind": "json",
      "input": "fixtures/duplicate-key.json",
      "expected_code": "invalid_input",
      "expected_publish": false
    },
    {
      "id": "ERROR-NONFINITE",
      "kind": "json",
      "input": "fixtures/nonfinite.json",
