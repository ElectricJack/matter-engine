# Used by native CMake and the existing Linux Make target. Sources are embedded
# at build time, so tests execute the delivered modules without fixture reads.
if(NOT DEFINED MATTER_SCRIPT_ROOT OR NOT DEFINED MATTER_SCRIPT_HEADER)
    message(FATAL_ERROR "MATTER_SCRIPT_ROOT and MATTER_SCRIPT_HEADER are required")
endif()
set(_header "#pragma once\n#include <vector>\n#include \"module_resolver.h\"\n")
set(_entries "")
foreach(_name particleflow strands rng)
    set(_source "${MATTER_SCRIPT_ROOT}/MatterEngine3/shared-lib/${_name}.js")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_source}")
    endif()
    file(READ "${_source}" _bytes HEX)
    string(REGEX REPLACE "(..)" "0x\\1," _bytes "${_bytes}")
    string(APPEND _header "inline const unsigned char script_${_name}[] = {${_bytes}0};\n")
    string(APPEND _entries "{\"shared-lib/${_name}\", std::string(reinterpret_cast<const char*>(script_${_name}), sizeof(script_${_name}) - 1), \"embedded://${_name}\"},\n")
endforeach()
string(APPEND _header "inline std::vector<module_resolver::ResolvedModule> script_test_modules() { return {${_entries}}; }\n")
file(WRITE "${MATTER_SCRIPT_HEADER}" "${_header}")
