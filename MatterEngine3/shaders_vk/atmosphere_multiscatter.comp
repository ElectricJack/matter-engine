#version 460
#include "atmosphere_common.glsl"
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D transmittance_tex;
layout(set=0,binding=1,rgba16f) uniform writeonly image2D multiscatter_out;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(32)))) return;
    float altitude = 100000.0 * (float(pixel.y) + 0.5) / 32.0;
    float sun_mu = -1.0 + 2.0 * (float(pixel.x) + 0.5) / 32.0;
    vec3 sun_direction = vec3(sqrt(max(0.0,1.0-sun_mu*sun_mu)),sun_mu,0.0);
    vec3 origin = vec3(0.0, ATM_PLANET_RADIUS + altitude, 0.0);
    vec3 l1 = vec3(0.0); float return_fraction = 0.0;
    for (int i = 0; i < 16; ++i) {
        float z = 1.0 - 2.0 * (float(i) + 0.5) / 16.0;
        float phi = 2.39996323 * float(i);
        vec3 direction = vec3(sqrt(max(0.0, 1.0-z*z))*cos(phi), z,
                              sqrt(max(0.0, 1.0-z*z))*sin(phi));
        float top_t = atmosphere_exit(origin, direction, ATM_TOP_RADIUS);
        float ground_t = atmosphere_exit(origin, direction, ATM_PLANET_RADIUS);
        float ray_t = ground_t > 0.0 && ground_t < top_t ? ground_t : top_t;
        for (int step=0; step<20; ++step) {
            float t = (float(step)+0.5) * ray_t / 20.0;
            vec3 point = origin + direction*t;
            float h=max(0.0,length(point)-ATM_PLANET_RADIUS);
            vec3 view_t=atmosphere_segment_transmittance(origin,direction,t,20);
            float local_sun_mu=dot(normalize(point),sun_direction);
            vec3 sun_t=texture(transmittance_tex,vec2((local_sun_mu+1.0)*0.5,h/100000.0)).rgb;
            vec3 scatter=ATM_RAYLEIGH*atmosphere.settings0.x*atmosphere_density_rayleigh(h)+
                         ATM_MIE_SCATTER*atmosphere.settings0.y*atmosphere_density_mie(h);
            l1 += ATM_EXTRATERRESTRIAL_SOLAR_RGB*view_t*sun_t*scatter*(ray_t/20.0)*(4.0*ATM_PI/16.0);
            return_fraction += clamp(dot(scatter,vec3(0.333333))*(ray_t/20.0),0.0,0.95)/16.0;
        }
    }
    float r = clamp(return_fraction, 0.0, 0.95);
    imageStore(multiscatter_out, pixel, vec4(l1 / max(1.0-r, 0.05), 1.0));
}
