#version 460

// HZB pyramid build (volumetric-sectors M4 Phase B, design §5.1).
//
// One level per dispatch. Level 0 min-reduces the frame's depth attachment;
// each later level min-reduces the one before it. cull.comp then tests a
// cluster's screen-space AABB against whichever level makes its footprint two
// texels wide.
//
// MIN, and the direction matters. This engine is reversed-Z (see
// frame_matrices.cpp:99-102): depth 1 is the near plane and 0 is far. The depth
// attachment holds, per pixel, the NEAREST surface -- the largest value. A
// conservative occluder for a whole footprint is therefore the SMALLEST of
// those per-pixel nearest surfaces: "even the closest thing here is at least
// this far away". An object is occluded only if its own nearest point is
// further than that, so an over-estimate here would hide visible geometry and
// an under-estimate merely draws something that was hidden. Min errs the safe
// way; max would be the bug.
//
// Sky reads the depth CLEAR, which under reversed-Z is 0.0 -- the far plane.
// So an untouched pixel poisons its whole footprint down to "occludes nothing",
// which is exactly right and needs no special case.
//
// EVERY SOURCE TEXEL IS VISITED, by integer footprint rather than by four
// bilinear taps. Two reasons, both fatal to the shortcut: a linear tap AVERAGES
// where this must minimise, and a fixed tap pattern over a non-integer ratio
// (level 0 is 1920x1080 -> 256x256, so 7.5 x 4.2 texels per destination) skips
// source texels, which can only raise the stored minimum -- the direction that
// hides visible geometry. The loop is bounded by kMaxFootprint and the bound is
// reported by failing OPEN (see below), never by silently sampling less.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, r32f) uniform image2D destination;

// No push constants and no uniforms: both extents come from the bound images
// themselves. That is not only shorter, it removes the one way this shader
// could be wrong without failing -- a stale or mismatched size constant would
// reduce the wrong footprint and quietly produce a pyramid that occludes real
// geometry. The images cannot disagree with themselves.

// A destination texel covering more source than this is clamped, and a clamped
// reduction could over-estimate. 32 covers level 0 at 8K (8192 / 256 = 32) with
// the later levels at a fixed ratio of 4, so the clamp is unreachable on any
// extent this renderer creates. It exists so a future extent cannot turn a
// missed texel into an invisible correctness bug.
const int kMaxFootprint = 32;

void main() {
    const ivec2 dst_size = imageSize(destination);
    const ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= dst_size.x || texel.y >= dst_size.y) return;

    const ivec2 src_size = textureSize(source, 0);
    const vec2 scale = vec2(src_size) / vec2(dst_size);
    const ivec2 lo = ivec2(floor(vec2(texel) * scale));
    ivec2 hi = ivec2(ceil((vec2(texel) + 1.0) * scale)) - 1;
    hi = min(hi, src_size - 1);
    hi = min(hi, lo + (kMaxFootprint - 1));

    float reduced = 1.0;
    for (int y = lo.y; y <= hi.y; ++y)
        for (int x = lo.x; x <= hi.x; ++x)
            reduced = min(reduced, texelFetch(source, ivec2(x, y), 0).r);

    imageStore(destination, ivec2(texel), vec4(reduced, 0.0, 0.0, 0.0));
}
