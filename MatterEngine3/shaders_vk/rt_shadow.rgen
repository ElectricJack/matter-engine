#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

// Phase 2 (horizon-map lighting): shares RT set 0 with rt_lighting.rgen /
// rt_surface_common.glsl's consumers -- bindings 15 (tileset texture array)
// / 16 (TilesetParams UBO) are already written into this set every frame
// (VkSceneRenderer::update_rt_descriptors), this shader simply hadn't
// declared them before. Only bindings 0/1/2 (this file's own) plus 4/11
// (reused below, declared locally) were previously in use here -- no
// binding conflicts with 15/16.
#define TILESET_SET 0
#define TILESET_TEX_BINDING 15
#define TILESET_PARAMS_BINDING 16
#include "tileset_common.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1) uniform sampler2D depth_texture;
layout(set = 0, binding = 2, rgba16f) uniform image2D visibility_image;

// Ground-POM roof escape (mirrors rt_lighting.rgen's identical fix, see its
// "Ground-POM roof escape" comment): rt_shadow is depth-only and has no
// material context of its own, so it reuses two bindings that already exist
// in the shared RT descriptor set (set 0) populated by
// VkSceneRenderer::record_ray_trace_dispatch for rt_lighting.rgen -- binding
// 4 (RT material table) and binding 11 (GBuffer identity/material-instance
// attachment). Both are declared here as raygen-visible reads only; no
// renderer-side descriptor-set changes were needed since the writes already
// cover the RAYGEN stage for these bindings.
struct RtMaterialGpu {
    vec4 base_roughness;
    vec4 metal_opacity_spec_coat;
    vec4 specular_tint_coat_roughness;
    vec4 emission_strength;
    vec4 transmission;
    vec4 absorption_pad;
    vec4 scattering;
    vec4 scattering_shape;
    uvec4 flags_misc;
};

layout(set = 0, binding = 4, std430) readonly buffer RtMaterialTable {
    RtMaterialGpu rt_materials[];
};

layout(set = 0, binding = 11) uniform usampler2D identity_texture;

// GBuffer ORM. Declared for the same reason as bindings 4 and 11 above: it is
// already written into this set every frame for rt_lighting.rgen (binding 10,
// RAYGEN-visible, SHADER_READ_ONLY_OPTIMAL by the time either raygen runs --
// both dispatches are recorded by one record_ray_trace_dispatch after the
// single descriptor update), this shader simply had not declared it.
//
// Only .w is read here: gbuffer.frag's baked-horizon SUN visibility for the
// parallaxed ground, computed in the frame the ground is addressed in.
layout(set = 0, binding = 10) uniform sampler2D orm_texture;

layout(push_constant) uniform ShadowConstants {
    mat4 clip_to_world;
    vec3 to_sun;
    float max_distance;
    float bias;
    uint samples;
    uint debug_view;
    // World-space distance to lift the shadow ray origin along the sun
    // direction for ground-tileset materials, so the ray clears the flat
    // ground mesh still sitting in the TLAS above the marched (recessed)
    // GBuffer depth. See rt_lighting.rgen's roof-escape comment for the
    // underlying bug; computed on the CPU from the LIVE tileset POM relief
    // cap (VkSceneRenderer::tileset_pom_settings_.relief_cap_m + 0.02), so
    // the tuning UI's slider keeps working here too.
    float pom_lift;
    // Sun angular size as a multiple of the shipped default (0.53 deg), from
    // VulkanLightingOverrides::sun_angular_diameter_deg via
    // matter/sun_angles.h. Scales the cone the shadow rays are jittered
    // inside, which is what makes a bigger sun cast softer penumbrae. EXACTLY
    // 1.0 at the default, so `0.002 * sun_cone_scale` below is bit-identical
    // to the 0.002 this shader used to hardcode.
    float sun_cone_scale;
} constants;

struct VisibilityPayload {
    vec3 visibility;
    uint layers;
};

layout(location = 0) rayPayloadEXT VisibilityPayload payload;

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 extent = ivec2(gl_LaunchSizeEXT.xy);
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(extent);
    float depth = texelFetch(depth_texture, pixel, 0).x;
    // Reversed-Z: far/cleared background is now 0.0 (was 1.0 under standard-Z).
    if (depth <= 0.0) {
        imageStore(visibility_image, pixel, vec4(1.0));
        return;
    }
    vec4 world_h = constants.clip_to_world *
                   vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    vec3 world = world_h.xyz / world_h.w;
    vec3 sun = normalize(constants.to_sun);
    // Ground-POM roof escape: lift ALONG the sun ray (not along the surface
    // normal, which rt_shadow does not have here) so the lift only ever
    // skips the [0, t] segment directly behind the origin -- it cannot
    // introduce a sideways leak. Clamping sun.y bounds the lift at grazing
    // sun angles instead of blowing up toward the horizon.
    uvec2 identity = texelFetch(identity_texture, pixel, 0).rg;
    // Phase 2 (horizon-map lighting): hoist the detail-slot lookup out of
    // this if block (it previously only tested `!= 0u` inline) so the
    // horizon-occlusion test below can reuse it.
    int shadow_tileset_slot = -1;
    if (identity.x < rt_materials.length()) {
        RtMaterialGpu roof_mat = rt_materials[identity.x];
        shadow_tileset_slot = tileset_detail_slot(roof_mat.flags_misc);
        if (shadow_tileset_slot >= 0)
            world += sun * (constants.pom_lift / max(sun.y, 0.05));
    }
    // Baked per-direction horizon visibility toward the sun, READ FROM THE
    // GBUFFER rather than re-derived here (issue 91919e5d, "I'm still not
    // seeing the horizon matching the POM texturing").
    //
    // What this replaced:
    //
    //     float occl = tileset_horizon_occlusion(shadow_tileset_slot,
    //                                            world.xz, sun,
    //                                            vec2(0.0), vec2(0.0));
    //
    // and every argument in it was wrong by the time it ran.
    //
    // POSITION. `world` above is no longer the shading point: the roof escape
    // three lines up moved it pom_lift / max(sun.y, 0.05) metres ALONG THE SUN
    // so the ray clears the flat ground mesh. That lift is a legitimate ray
    // origin and a nonsensical texture coordinate. At this world's sun
    // (elevation 24.8 deg) and the shipped relief cap it displaces the lookup
    // 0.81 m across the ground -- 1.6 brick pitches, 3.2 course pitches on
    // BrickProof -- along the sun azimuth. That alone put every horizon shadow
    // a brick and a half from the groove that casts it, which is exactly the
    // "right direction, wrong registration" in the report.
    //
    // FRAME. world.xz and the world azimuth/elevation of `sun` were the
    // addressing the raster ground abandoned in c3fea496 / 7915bd1f: the
    // ground is addressed by the warped ground field, and the horizon channels
    // are baked in the TILE's own texel frame, so the query has to be resolved
    // onto that frame (marched_uv, (s.dir_u, s.dir_v), s.plane_n). A raygen
    // shader cannot do that -- it has no warp frame, no tangent, not even a
    // surface normal -- so the two frame fixes that landed on gbuffer.frag
    // could never have reached here. Reading the answer is the only way this
    // shader can be right.
    //
    // FILTERING. Passing zero derivatives pinned the fetch at mip 0 with the
    // fixed 0.05 soft edge, which is the exact failure
    // tileset_horizon_relief_occlusion_frame's footprint-widened edge exists
    // to fix -- a threshold applied to a mip-filtered mean.
    //
    // The gbuffer value already carries horizon_strength and the POM fade, and
    // is 1.0 for every pixel that is not parallaxed ground -- including the
    // no-horizon-data and no-tileset cases the old guard handled -- so the
    // slot test is only kept to skip the fetch, not to make it safe.
    float horizon_visibility = 1.0;
    if (shadow_tileset_slot >= 0)
        horizon_visibility = clamp(texelFetch(orm_texture, pixel, 0).w,
                                   0.0, 1.0);
    vec3 tangent = normalize(abs(sun.y) < 0.99
                                 ? cross(sun, vec3(0.0, 1.0, 0.0))
                                 : cross(sun, vec3(1.0, 0.0, 0.0)));
    vec3 bitangent = cross(sun, tangent);
    uint sample_count = clamp(constants.samples, 1u, 16u);
    vec3 sum = vec3(0.0);
    for (uint sample_index = 0; sample_index < sample_count; ++sample_index) {
        uint seed = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u +
                    sample_index * 26699u + 911u;
        seed = (seed << 13u) ^ seed;
        float a = float(seed & 0xffffu) / 65535.0 * 6.28318530718;
        // ONE sample means a hard ray, still. That is not an oversight: it
        // is the shipped default (VulkanRayTracingSettings::samples == 1), a
        // single jittered ray would be noise rather than a penumbra, and
        // keeping it exact is what lets a default render stay pixel-identical
        // to a build without sun sizing. Raise
        // VulkanLightingOverrides::sun_shadow_samples to actually resolve the
        // cone; the radius then scales linearly with the sun's angular size.
        //
        // The sqrt(i + 0.5) spiral is pre-existing and makes the effective
        // cone widen slightly with the sample count. Left as it was, because
        // changing it would move every multi-sample shadow already tuned.
        float radius = sample_count == 1u ? 0.0 :
                       0.002 * constants.sun_cone_scale *
                       sqrt(float(sample_index) + 0.5);
        vec3 direction = normalize(sun + radius *
            (cos(a) * tangent + sin(a) * bitangent));
        payload.visibility = vec3(1.0);
        payload.layers = 0u;
        traceRayEXT(scene, gl_RayFlagsTerminateOnFirstHitEXT |
                            gl_RayFlagsOpaqueEXT,
                    0x01, 0, 0, 0, world + sun * constants.bias,
                    constants.bias, direction, constants.max_distance, 0);
        if (max(payload.visibility.r,
                max(payload.visibility.g, payload.visibility.b)) >= 0.01) {
            traceRayEXT(scene, gl_RayFlagsNoneEXT, 0x02, 0, 0, 0,
                        world + sun * constants.bias, constants.bias,
                        direction, constants.max_distance, 0);
        }
        sum += payload.visibility;
    }
    imageStore(visibility_image, pixel,
               vec4(sum / float(sample_count) * horizon_visibility, 1.0));
}
