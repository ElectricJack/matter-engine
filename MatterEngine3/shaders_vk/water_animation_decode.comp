#version 460

// One workgroup decodes one contiguous asset slice. Multiple river sections
// share the same packed/decoded arenas and are dispatched with different push
// constants. The file ABI is three uint words (12 bytes) per vertex.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer PackedVertices {
    uint words[];
} packed_vertices;

struct WaterAnimationVertex {
    vec3 position;
    vec3 normal;
    uint material_index;
};

layout(set = 0, binding = 1, std430) writeonly buffer DecodedVertices {
    WaterAnimationVertex vertices[];
} decoded_vertices;

layout(push_constant) uniform DecodePush {
    vec4 bounds_min;
    vec4 bounds_extent;
    uvec4 meta;  // packed word offset, output vertex, count, material
} pc;

float unpack_snorm16(uint bits) {
    int value = int(bits & 0xffffu);
    if (value >= 32768) value -= 65536;
    return max(-1.0, float(value) / 32767.0);
}

float sign_not_zero(float value) {
    return value < 0.0 ? -1.0 : 1.0;
}

vec3 decode_octahedral(uint packed_x, uint packed_y) {
    vec3 normal = vec3(unpack_snorm16(packed_x),
                       unpack_snorm16(packed_y), 0.0);
    normal.z = 1.0 - abs(normal.x) - abs(normal.y);
    if (normal.z < 0.0) {
        float old_x = normal.x;
        normal.x = (1.0 - abs(normal.y)) * sign_not_zero(old_x);
        normal.y = (1.0 - abs(old_x)) * sign_not_zero(normal.y);
    }
    float length_squared = dot(normal, normal);
    return length_squared > 1.0e-16
               ? normal * inversesqrt(length_squared)
               : vec3(0.0, 1.0, 0.0);
}

void main() {
    uint local_vertex = gl_GlobalInvocationID.x;
    if (local_vertex >= pc.meta.z) return;
    uint word = pc.meta.x + local_vertex * 3u;
    uint xy = packed_vertices.words[word + 0u];
    uint znx = packed_vertices.words[word + 1u];
    uint ny = packed_vertices.words[word + 2u];
    vec3 unorm = vec3(float(xy & 0xffffu), float(xy >> 16u),
                      float(znx & 0xffffu)) / 65535.0;
    WaterAnimationVertex decoded;
    decoded.position = pc.bounds_min.xyz + pc.bounds_extent.xyz * unorm;
    decoded.normal = decode_octahedral(znx >> 16u, ny);
    decoded.material_index = pc.meta.w;
    decoded_vertices.vertices[pc.meta.y + local_vertex] = decoded;
}
