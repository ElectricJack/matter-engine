#version 450
#include "solid_field.glsl"
#include "gpu_mesh_mc_tables.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 2) readonly buffer Field {
    float field[];
};
layout(std430, binding = 3) readonly buffer Cells {
    uvec2 cells[];
};
layout(std430, binding = 4) readonly buffer Blocks {
    uint blocks[];
};
layout(std430, binding = 5) readonly buffer Table {
    int triangles[];
};
layout(std430, binding = 6) readonly buffer Status {
    uvec4 status;
};
struct Vertex {
    vec4 position;
    vec4 normal;
};
layout(std430, binding = 7) writeonly buffer Output {
    Vertex vertices[];
};
vec3 edgePosition(uvec3 b, uint e) {
    uvec2 ends = gpuMeshEdgeCorners(e);
    uvec3 a = b + gpuMeshCornerOffset(ends.x), c = b + gpuMeshCornerOffset(ends.y);
    float x = field[solidIndex(a)], y = field[solidIndex(c)];
    float t = abs(y - x) > 1e-20 ? clamp(-x / (y - x), 0, 1) : .5;
    return origin.xyz + spacing.xyz * mix(vec3(a), vec3(c), t);
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= limits.y || status.y != 0u)
        return;
    uvec2 cell = cells[i];
    uvec3 b = solidCoordinate(i, dims.xyz - uvec3(1));
    uint dst = blocks[i / 256u] + cell.y;
    for (uint t = 0u; t < 15u; t += 3u) {
        int e = triangles[cell.x * 16u + t];
        if (e < 0)
            break;
        vec3 p[3];
        for (uint k = 0u; k < 3u; ++k)
            p[k] = edgePosition(b, uint(triangles[cell.x * 16u + t + k]));
        vec3 g = cross(p[1] - p[0], p[2] - p[0]);
        float l = length(g);
        g = l > 1e-20 ? g / l : vec3(0, 1, 0);
        vec3 n[3];
        for (uint k = 0u; k < 3u; ++k)
            n[k] = solidNormal(p[k], g);
        // Table orientation varies with field convention. Emit outward winding.
        bool flip = dot(g, n[0] + n[1] + n[2]) < 0;
        for (uint k = 0u; k < 3u; ++k) {
            uint q = flip && k > 0u ? 3u - k : k;
            vertices[dst + t + k].position = vec4(p[q], 1);
            vertices[dst + t + k].normal = vec4(n[q], 0);
        }
    }
}
