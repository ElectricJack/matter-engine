#version 460
#extension GL_GOOGLE_include_directive : require

#include "vol_common.glsl"
#include "cloud_density.glsl"
#include "vt_noise.glsl"   // vt_fbm3 — the engine's one value-noise core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 1) in;

// How many cloud decks this pipeline evaluates, 0..kMaxCloudLayers.
//
// A SPECIALIZATION CONSTANT, not a uniform, and that is the whole design.
// This shader runs once per froxel — 160 * 90 * 128 = 1.84M of them every
// frame — and every octave of every layer is evaluated inside that loop. A
// uniform loop bound would leave the loop, its bounds check and its SSBO
// indexing in the binary for a world with no clouds at all, which is most of
// them. As a specialization constant the driver compiles CLOUD_LAYERS = 0
// down to nothing: no loop, no buffer read, no cost. VkVolumetrics::init
// builds one pipeline per count from one SPIR-V module (see
// create_density_pipelines), so this costs pipeline objects, not shader
// permutation sources.
//
// The per-layer OCTAVE count is deliberately NOT specialized. It would
// multiply the permutation count by five for an inner loop whose trip count
// the compiler can already hoist per layer, and pipelines are the thing worth
// being frugal with here.
layout(constant_id = 0) const int CLOUD_LAYERS = 0;
layout(constant_id = 1) const bool ENHANCED_CLOUDS = false;

layout(rgba16f, set = 0, binding = 0) uniform writeonly image3D vol_media;
layout(set = 0, binding = 1) uniform sampler3D noise_tex;

layout(std430, set = 0, binding = 2) readonly buffer EmitterSSBO {
    uint emitter_count;
    GpuVolumeEmitter emitters[];
};

// Always bound and always kMaxCloudLayers entries long, even when
// CLOUD_LAYERS is 0 — a descriptor set layout cannot be specialized, and an
// unread binding costs nothing.
layout(std430, set = 0, binding = 3) readonly buffer CloudSSBO {
    GpuCloudLayer cloud_layers[];
};
layout(r16f, set = 0, binding = 4) uniform writeonly image3D vol_cloud_density;

layout(push_constant) uniform DensityConstants {
    mat4 clip_to_world;
    vec3 camera_pos;
    float frame_time;
    float fog_density;
    float fog_floor;
    float fog_falloff;
    float camera_near;
    vec3 fog_color;
    float camera_far;
    vec3 fog_wind;
    float pad2;
} pc;

// ---------------------------------------------------------------------------
// Cloud layers
//
// GLSL twin of cloud_height_profile() in matter/cloud_layers.h. Keep the two
// in lockstep — cloud_layer_tests.cpp pins the CPU side and this is what
// actually shades. The shapes are: zero outside (min, max), a soft shoulder
// of falloff_min metres up from the bottom, a soft shoulder of falloff_max
// metres down from the top, and a true plateau at 1.0 between them.
// ---------------------------------------------------------------------------
float legacy_cloud_height_profile(GpuCloudLayer L, float y) {
    float lo = L.min_height;
    float hi = L.max_height;
    if (!(hi > lo)) return 0.0;
    if (y <= lo || y >= hi) return 0.0;

    float thickness = hi - lo;
    float f_lo = clamp(L.falloff_min, 0.0, thickness);
    float f_hi = clamp(L.falloff_max, 0.0, thickness);

    float rise = f_lo > 0.0 ? smoothstep(lo, lo + f_lo, y) : 1.0;
    float fall = f_hi > 0.0 ? 1.0 - smoothstep(hi - f_hi, hi, y) : 1.0;
    // min(), not the product: only min() holds a true plateau at 1.0 between
    // the shoulders, which is what makes max_density a density the deck
    // actually reaches rather than one it merely approaches.
    return min(rise, fall);
}

// The horizontal shape: an fbm field thresholded by `coverage`.
//
// Full 3D noise, with no vertical-coherence trick. The old single-layer path
// squashed the third texture coordinate to stop view-ray integration
// averaging the noise back into uniform haze, but that hack existed because
// the noise was sampled from a 32^3 texture at a fixed frequency. Here the
// layer's own noise_scale does the job: a 100 m deck at 0.0016 spans 0.16 of
// a lattice cell vertically, so the field is already near-constant through
// the deck's thickness and the banks stay coherent along a view ray.
float cloud_shape(GpuCloudLayer L, vec3 world_pos, float time) {
    vec3 wind = vec3(L.wind[0], L.wind[1], L.wind[2]);
    vec3 p = (world_pos + wind * time) * L.noise_scale;
    float n = vt_fbm3(p.x, p.y, p.z, uint(L.seed), int(L.octaves),
                      L.gain, L.lacunarity, 1.0, false);
    n = n * 0.5 + 0.5;                       // vt_fbm3 is ~-1..1 -> 0..1
    // coverage c keeps the field above (1 - c). c = 1 is solid, c = 0 clear,
    // and the shoulder either side keeps the bank edges billowing rather than
    // cut out.
    float threshold = 1.0 - L.coverage;
    return smoothstep(threshold - CLOUD_COVERAGE_EDGE,
                      threshold + CLOUD_COVERAGE_EDGE, n);
}

void main() {
    ivec3 voxel = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 grid = imageSize(vol_media);
    if (any(greaterThanEqual(voxel, grid))) return;

    // Iterate over all depth slices for this XY thread.
    for (int z = 0; z < grid.z; ++z) {
        float depth = slice_to_depth(float(z) + 0.5, float(grid.z));

        // Slices closer than the camera near plane have no valid NDC mapping.
        if (depth < pc.camera_near) {
            imageStore(vol_media, ivec3(voxel.xy, z), vec4(0.0));
            continue;
        }

        vec2 uv = (vec2(voxel.xy) + 0.5) / vec2(grid.xy);
        // Reversed-ZO: hw=1 at z=near, hw=0 at z=far.
        // Verify: z=near -> near*(far-near)/(near*(far-near)) = 1;
        //         z=far  -> near*(far-far)/(far*(far-near))   = 0.
        float ndc_z = pc.camera_near * (pc.camera_far - depth) /
                      ((pc.camera_far - pc.camera_near) * depth);
        vec4 clip_pos = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, ndc_z, 1.0);
        vec4 world_h = pc.clip_to_world * clip_pos;
        vec3 world_pos = world_h.xyz / world_h.w;

        // --- Ground fog: exponential decay upward from the floor ---
        //
        // Always evaluated, and byte-for-byte the arithmetic it has always
        // been. The bounded-cloud branch that used to live alongside it is
        // gone; decks are the CLOUD_LAYERS loop below and they ADD to this
        // rather than replacing it, so a world with `density` set and no
        // layers renders exactly as before.
        float y = world_pos.y;
        float height_fog = pc.fog_density *
            exp(-max(y - pc.fog_floor, 0.0) /
                max(pc.fog_falloff, 0.01));
        {
            vec3 noise_coord =
                (world_pos + pc.fog_wind * pc.frame_time) * 0.02;
            float noise_val = texture(noise_tex, noise_coord).r;
            height_fog *= mix(0.5, 1.5, noise_val);
        }

        vec3 fog_albedo = pc.fog_color;
        float extinction = height_fog;
        float non_cloud_extinction = height_fog;

        // --- Cloud decks ---
        //
        // Compiled away entirely at CLOUD_LAYERS = 0 (see the constant's
        // declaration). Layers SUM their extinction: extinction is a physical
        // density, so two overlapping decks are denser than either, and max()
        // would make a thin veil vanish inside a thick base instead of
        // thickening it.
        //
        // The height profile is evaluated FIRST and the fbm is skipped when it
        // is zero. That test is the difference between paying for the noise in
        // every froxel and paying for it only in the froxels a deck actually
        // occupies, which for a deck a hundred metres thick in a three-
        // kilometre frustum is a small minority of the 1.84M.
        float cloud_extinction = 0.0;
        for (int li = 0; li < CLOUD_LAYERS; ++li) {
            GpuCloudLayer L = cloud_layers[li];
            cloud_extinction += evaluate_cloud_density(L, world_pos, pc.frame_time).full;
        }
        extinction += cloud_extinction;

        // --- Emitter contributions ---
        for (uint i = 0; i < emitter_count; ++i) {
            vec3 emitter_pos = vec3(emitters[i].world_pos[0],
                                    emitters[i].world_pos[1],
                                    emitters[i].world_pos[2]);
            vec3 emitter_dir = vec3(emitters[i].world_dir[0],
                                    emitters[i].world_dir[1],
                                    emitters[i].world_dir[2]);
            vec3 emitter_color = vec3(emitters[i].color[0],
                                      emitters[i].color[1],
                                      emitters[i].color[2]);
            float radius = emitters[i].radius;
            float spread = emitters[i].spread;
            float length_ = emitters[i].axial_len;
            float e_density = emitters[i].density;
            float rise = emitters[i].rise;
            float turbulence = emitters[i].turbulence;

            vec3 to_voxel = world_pos - emitter_pos;

            // Rise offset: shift the effective center upward over time.
            to_voxel.y -= rise * pc.frame_time;

            // Axial distance along the emitter direction.
            float axial = dot(to_voxel, emitter_dir);
            float axial_fade = 1.0;
            if (length_ > 0.0) {
                axial_fade = 1.0 - smoothstep(0.0, length_, abs(axial));
            }

            // Cone radius at this axial distance.
            float cone_r = radius + max(axial, 0.0) * spread;

            // Radial distance from the cone axis.
            vec3 radial_vec = to_voxel - axial * emitter_dir;
            float radial_dist = length(radial_vec);

            // Smooth radial falloff.
            float radial_falloff = 1.0 - smoothstep(0.0, cone_r, radial_dist);

            // Curl-noise warp from the noise texture for turbulence.
            if (turbulence > 0.0) {
                vec3 warp_coord = (world_pos + pc.fog_wind * pc.frame_time * 0.5) * 0.05;
                vec3 warp = (texture(noise_tex, warp_coord).rgb - 0.5) * 2.0;
                vec3 warped_pos = world_pos + warp * turbulence * radius;
                vec3 warped_to = warped_pos - emitter_pos;
                warped_to.y -= rise * pc.frame_time;
                float warped_radial = length(warped_to - dot(warped_to, emitter_dir) * emitter_dir);
                radial_falloff = 1.0 - smoothstep(0.0, cone_r, warped_radial);
            }

            float emitter_contrib = e_density * radial_falloff * axial_fade;
            extinction += emitter_contrib;
            non_cloud_extinction += emitter_contrib;
            if (ENHANCED_CLOUDS) {
                fog_albedo = mix(fog_albedo, emitter_color,
                                 clamp(emitter_contrib / max(non_cloud_extinction, 1e-6), 0.0, 1.0));
            } else {
                // Current specialization retains the existing arithmetic.
                fog_albedo = mix(fog_albedo, emitter_color,
                                 clamp(emitter_contrib / max(extinction, 1e-6), 0.0, 1.0));
            }
        }

        // Store rgb = albedo * density (scattering coefficient), a = extinction.
        vec3 scattering = ENHANCED_CLOUDS
            ? fog_albedo * non_cloud_extinction + vec3(0.99) * cloud_extinction
            : fog_albedo * extinction;
        imageStore(vol_media, ivec3(voxel.xy, z), vec4(scattering, extinction));
        if (ENHANCED_CLOUDS)
            imageStore(vol_cloud_density, ivec3(voxel.xy, z), vec4(cloud_extinction));
    }
}
