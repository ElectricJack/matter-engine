#version 450

#include "gpu_mesh_common.glsl"

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer ParamsBuffer {
    GpuMeshBinParams params;
};
layout(std430, binding = 1) readonly buffer ParticleBuffer {
    GpuMeshParticle particles[];
};
layout(std430, binding = 2) readonly buffer CountBuffer {
    uint counts[];
};
layout(std430, binding = 3) readonly buffer OffsetBuffer {
    uint offsets[];
};
layout(std430, binding = 4) buffer CursorBuffer {
    uint cursors[];
};
layout(std430, binding = 5) writeonly buffer IdBuffer {
    uint particleIds[];
};

void main() {
    const uint particleId = gl_GlobalInvocationID.x;
    if (particleId >= params.counts.x) return;
    const vec3 relative =
        (particles[particleId].positionM - params.binOriginAndSize.xyz) /
        params.binOriginAndSize.w;
    const ivec3 coordinate = ivec3(floor(relative));
    const ivec3 dimensions = ivec3(params.binDimsAndCount.xyz);
    if (any(lessThan(coordinate, ivec3(0))) ||
        any(greaterThanEqual(coordinate, dimensions))) return;
    const uint bin = gpuMeshLinearBin(uvec3(coordinate),
                                      params.binDimsAndCount.xyz);
    const uint cursor = atomicAdd(cursors[bin], 1u);
    if (cursor < counts[bin]) particleIds[offsets[bin] + cursor] = particleId;
}
