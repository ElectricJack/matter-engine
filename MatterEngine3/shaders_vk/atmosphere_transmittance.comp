#version 460
#include "atmosphere_common.glsl"
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(set=0,binding=0,rgba16f) uniform writeonly image2D transmittance_out;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(256, 64)))) return;
    float altitude = 100000.0 * float(pixel.y) / 63.0;
    float mu = -1.0 + 2.0 * float(pixel.x) / 255.0;
    vec3 direction = vec3(sqrt(max(0.0, 1.0 - mu * mu)), mu, 0.0);
    vec3 origin = vec3(0.0, ATM_PLANET_RADIUS + altitude, 0.0);
    bool planet_hit = false;
    vec3 value = atmosphere_transmittance(origin, direction, 40, planet_hit);
    imageStore(transmittance_out, pixel, vec4(planet_hit ? vec3(0.0) : value, 1.0));
}
