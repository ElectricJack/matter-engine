#version 460
// vt_composite.comp — WP-D tier-1 chart-page compositor (chart-space virtual
// texturing, spec Phase 2b).
//
// One dispatch per requested page: 17x17 workgroups of 8x8 cover the full
// 136^2 physical page (128 payload + 4-texel border on every side). Per
// texel:
//   1. Map the physical texel to its virtual-atlas texel at the request's
//      mip, then to finest-mip coordinates (texel centers).
//   2. Resolve the owning surface point: iterate the CPU-provided candidate
//      chart list (fixed ascending order — determinism), invert each chart's
//      plane projection (chart_atlas.h convention) to get the query point in
//      that chart's plane space, and find the closest point over the chart's
//      chart-grouped triangle range. Distance 0 => texel is inside a
//      triangle (the unique owner, since chart rects are disjoint and UVs
//      map into rect content by construction). Distance > 0 => gutter /
//      out-of-chart texel: the globally nearest triangle point wins, which
//      IS the dilation fill (borders, gutters, and coarse-mip inter-chart
//      space all take the nearest real surface content).
//   3. Evaluate material weights behind the vt_material_weights seam
//      (Phase-2 stub: the triangle's TriEx materialId at weight 1; a debug
//      mode exercises the 2-material blend path for tests; WP-F replaces
//      the seam body with the surfaces() tape).
//   4. Sample each weighted material's Wang detail tileset TRIPLANAR in
//      part-local space (three planar samples along the local axes weighted
//      |n|^4), with textureLod at the page-texel footprint (mip policy: a
//      page at mip M has texels of 2^M / chart_tpm meters, so coarse pages
//      sample properly filtered tileset mips, not aliased ones).
//   5. Height-blend the top-2 materials by the tilesets' height channels
//      (exact passthrough at w = 0 / w = 1 — tested identities).
//   6. Write albedo / chart-tangent-space normal / ORM / aux (dominant
//      material id, secondary id, blend) to the intermediate storage
//      images; vt_bc_encode.comp compresses them afterwards.
//
// DETERMINISM: no time, no random, fixed iteration orders, ties broken by
// strict '<' (first candidate wins). Identical inputs => identical texels.

#extension GL_EXT_nonuniform_qualifier : require

#include "wang_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Page geometry — MUST match chart_atlas.h (kVtPagePayload/kVtPageBorder/
// kChartGutterTexels).
#define VT_PAGE_PAYLOAD 128
#define VT_PAGE_BORDER  4
#define VT_PAGE_STORE   136
#define VT_CHART_GUTTER 4

// MUST equal vt::VtCompositor::kMaxDetailSlots (vt_compositor.h).
#define VT_MAX_SLOTS 8
// Channels bound per slot (albedo, normal RG, ORM, height) — a subset of the
// 6-channel runtime tileset arrays; horizon channels are not composited.
#define VT_CH_ALBEDO 0
#define VT_CH_NORMAL 1
#define VT_CH_ORM    2
#define VT_CH_HEIGHT 3
#define VT_CHANNELS  4

// ---- set 0: per-(variant, rung) mesh/chart cache (built CPU-side from the
// part context, cached across fills) ---------------------------------------

struct GpuChart {
    vec4 origin_tpm;     // xyz part-local plane origin, w texels_per_meter
    vec4 tangent_ou;     // xyz T (unit), w = dot(origin, T)
    vec4 bitangent_ov;   // xyz B (unit), w = dot(origin, B)
    uvec4 rect;          // finest-mip atlas texels: x, y, w, h
    uvec4 tri_range;     // x = first tri (into tris[], chart-grouped), y = count
};
// Triangles already reordered by tri_order (chart-grouped) CPU-side, with
// per-vertex plane coordinates precomputed: plane U in p*.w, plane V in n*.w.
struct GpuTri {
    vec4 p0, p1, p2;     // xyz part-local position, w = plane U
    vec4 n0, n1, n2;     // xyz part-local normal,   w = plane V
    uvec4 mat;           // x = TriEx materialId
};

layout(std430, set = 0, binding = 0) readonly buffer ChartsBuf { GpuChart charts[]; };
layout(std430, set = 0, binding = 1) readonly buffer TrisBuf   { GpuTri tris[]; };

// ---- set 1: per-batch-slot resources --------------------------------------

struct GpuFillRequest {
    uvec4 a;             // x page_x, y page_y, z mip, w out_layer (intermediate)
    uvec4 b;             // x cand_offset, y cand_count, z weight_mode,
                         // w debug materials (mat_a | mat_b << 16)
    vec4 debug_params;   // weight_mode 1: x = blend start (plane U, meters),
                         //                y = blend width (meters)
};
struct GpuVtMaterial {
    vec4 albedo;         // scalar fallback albedo (rgb) when no detail slot
    vec4 orm;            // xyz scalar fallback ORM
    ivec4 slot;          // x = detail tileset slot, -1 = none
};

layout(std430, set = 1, binding = 0) readonly buffer RequestBuf { GpuFillRequest requests[]; };
layout(std430, set = 1, binding = 1) readonly buffer CandBuf    { uint cand_charts[]; };
layout(std430, set = 1, binding = 2) readonly buffer MaterialBuf { GpuVtMaterial materials[]; };
layout(set = 1, binding = 3, std140) uniform VtTilesetParams {
    // Per-slot scalars, four to a vec4 (same packing discipline as
    // tileset_common.glsl's TilesetParams — read via VT_SLOT_SCALAR).
    vec4 tile_size_m[VT_MAX_SLOTS / 4];
    vec4 texels_per_meter[VT_MAX_SLOTS / 4];
} vtp;
#define VT_SLOT_SCALAR(field, slot) (vtp.field[(slot) >> 2][(slot) & 3])

layout(set = 1, binding = 4)
    uniform sampler2DArray vtTilesetTex[VT_MAX_SLOTS * VT_CHANNELS];

layout(set = 1, binding = 5, rgba8) uniform writeonly image2DArray outAlbedo;
layout(set = 1, binding = 6, rgba8) uniform writeonly image2DArray outNormal;
layout(set = 1, binding = 7, rgba8) uniform writeonly image2DArray outOrm;
layout(set = 1, binding = 8, rgba8) uniform writeonly image2DArray outAux;

layout(push_constant) uniform Push { uint req_index; } pc;

// ---------------------------------------------------------------------------
// Closest point on a 2D triangle. Returns squared distance (0 when q is
// inside) and the barycentrics of the closest point. Fixed evaluation order
// (inside test, then edges AB, BC, CA with strict '<') for determinism.
// ---------------------------------------------------------------------------
float closest_tri_2d(vec2 q, vec2 a, vec2 b, vec2 c, out vec3 bary) {
    vec2 ab = b - a, ac = c - a, aq = q - a;
    float d00 = dot(ab, ab), d01 = dot(ab, ac), d11 = dot(ac, ac);
    float d20 = dot(aq, ab), d21 = dot(aq, ac);
    float denom = d00 * d11 - d01 * d01;
    if (abs(denom) > 1e-12) {
        float v = (d11 * d20 - d01 * d21) / denom;
        float w = (d00 * d21 - d01 * d20) / denom;
        if (v >= 0.0 && w >= 0.0 && v + w <= 1.0) {
            bary = vec3(1.0 - v - w, v, w);
            return 0.0;
        }
    }
    // Outside (or degenerate): closest point over the three edge segments.
    float best_d2 = 1e30;
    bary = vec3(1.0, 0.0, 0.0);
    // edge AB
    {
        float t = clamp(dot(q - a, ab) / max(d00, 1e-12), 0.0, 1.0);
        vec2 p = a + ab * t;
        float d2 = dot(q - p, q - p);
        if (d2 < best_d2) { best_d2 = d2; bary = vec3(1.0 - t, t, 0.0); }
    }
    // edge BC
    {
        vec2 bc = c - b;
        float t = clamp(dot(q - b, bc) / max(dot(bc, bc), 1e-12), 0.0, 1.0);
        vec2 p = b + bc * t;
        float d2 = dot(q - p, q - p);
        if (d2 < best_d2) { best_d2 = d2; bary = vec3(0.0, 1.0 - t, t); }
    }
    // edge CA
    {
        float t = clamp(dot(q - c, -ac) / max(d11, 1e-12), 0.0, 1.0);
        vec2 p = c - ac * t;
        float d2 = dot(q - p, q - p);
        if (d2 < best_d2) { best_d2 = d2; bary = vec3(t, 0.0, 1.0 - t); }
    }
    return best_d2;
}

// ---------------------------------------------------------------------------
// Triplanar Wang sampling of one material's detail tileset.
// ---------------------------------------------------------------------------
struct SurfSample {
    vec3 albedo;
    vec3 delta_n;    // part-local normal perturbation (added, then normalized)
    vec3 orm;
    float height;    // normalized [0,1] tileset height (0.5 for flat/scalar)
};

vec4 vt_tileset_lod(int slot, int channel, vec2 planarM, float lod) {
    int layer; vec2 uv;
    wang_resolve_size(VT_SLOT_SCALAR(tile_size_m, slot), planarM, layer, uv);
    int tex = slot * VT_CHANNELS + channel;
    float max_lod = float(textureQueryLevels(vtTilesetTex[nonuniformEXT(tex)]) - 1);
    return textureLod(vtTilesetTex[nonuniformEXT(tex)],
                      vec3(uv, float(layer)), clamp(lod, 0.0, max_lod));
}

SurfSample sample_material(uint mat_id, vec3 pos, vec3 nrm, float footprint_m) {
    GpuVtMaterial m = materials[mat_id & 0xFFu];
    SurfSample s;
    s.delta_n = vec3(0.0);
    int slot = m.slot.x;
    if (slot < 0 || slot >= VT_MAX_SLOTS) {
        s.albedo = m.albedo.rgb;
        s.orm    = m.orm.xyz;
        s.height = 0.5;
        return s;
    }
    // |n|^4 triplanar weights, normalized.
    vec3 w4 = nrm * nrm; w4 *= w4;
    float wsum = w4.x + w4.y + w4.z;
    w4 = (wsum > 1e-8) ? w4 / wsum : vec3(0.0, 1.0, 0.0);

    // Mip policy: LOD from the page-texel footprint against this tileset's
    // texel density, so a page at mip M reads matching tileset filtering.
    float duv_texels = footprint_m * VT_SLOT_SCALAR(texels_per_meter, slot);
    float lod = log2(max(duv_texels, 1.0));

    // Fixed per-axis planar frames (sign-independent — mirrored content on
    // back faces is the accepted tier-1 tradeoff, documented).
    //   X axis: coords (p.z, p.y), T=(0,0,1), B=(0,1,0)
    //   Y axis: coords (p.x, p.z), T=(1,0,0), B=(0,0,1)
    //   Z axis: coords (p.x, p.y), T=(1,0,0), B=(0,1,0)
    vec2 pc[3];
    pc[0] = pos.zy; pc[1] = pos.xz; pc[2] = pos.xy;
    const vec3 axisT[3] = vec3[3](vec3(0, 0, 1), vec3(1, 0, 0), vec3(1, 0, 0));
    const vec3 axisB[3] = vec3[3](vec3(0, 1, 0), vec3(0, 0, 1), vec3(0, 1, 0));

    vec3 albedo = vec3(0.0), orm = vec3(0.0), dn = vec3(0.0);
    float height = 0.0;
    for (int ax = 0; ax < 3; ++ax) {
        float w = w4[ax];
        if (w <= 1e-5) continue;
        vec4 alb = vt_tileset_lod(slot, VT_CH_ALBEDO, pc[ax], lod);
        vec4 nr  = vt_tileset_lod(slot, VT_CH_NORMAL, pc[ax], lod);
        vec4 om  = vt_tileset_lod(slot, VT_CH_ORM,    pc[ax], lod);
        vec4 hg  = vt_tileset_lod(slot, VT_CH_HEIGHT, pc[ax], lod);
        vec2 rg = nr.rg * 2.0 - 1.0;
        albedo += w * alb.rgb;
        orm    += w * om.rgb;
        height += w * hg.r;
        dn     += w * (axisT[ax] * rg.x + axisB[ax] * rg.y);
    }
    s.albedo = albedo;
    s.orm    = orm;
    s.height = height;
    s.delta_n = dn;
    return s;
}

// ---------------------------------------------------------------------------
// Material-weight seam (contract C4 hook). WP-F replaces THIS FUNCTION's body
// with the compiled surfaces() tape evaluation; callers and outputs stay
// fixed: top-2 materials with weights summing to 1 (w1 == 0 => single).
// ---------------------------------------------------------------------------
void vt_material_weights(uint weight_mode, uint debug_mats, vec4 debug_params,
                         vec3 pos, vec3 nrm, uint tri_mat, vec2 plane_uv,
                         out uint m0, out float w0, out uint m1, out float w1) {
    if (weight_mode == 1u) {
        // Debug/test mode: analytic 2-material ramp along plane U so the
        // height-blend path (and its w=0 / w=1 passthrough identities) is
        // testable before WP-F lands.
        m0 = debug_mats & 0xFFFFu;
        m1 = (debug_mats >> 16) & 0xFFFFu;
        w1 = clamp((plane_uv.x - debug_params.x) / max(debug_params.y, 1e-6),
                   0.0, 1.0);
        w0 = 1.0 - w1;
        return;
    }
    // Phase-2 stub: single material from the triangle's TriEx materialId.
    m0 = tri_mat; w0 = 1.0;
    m1 = tri_mat; w1 = 0.0;
}

void main() {
    uvec2 t = gl_GlobalInvocationID.xy;
    if (t.x >= uint(VT_PAGE_STORE) || t.y >= uint(VT_PAGE_STORE)) return;
    GpuFillRequest req = requests[pc.req_index];
    int out_layer = int(req.a.w);
    ivec3 store_at = ivec3(ivec2(t), out_layer);

    uint mip = req.a.z;
    // Virtual texel at this mip (border texels go negative / past the atlas
    // edge — the nearest-triangle search below handles them as dilation).
    ivec2 vt_texel = ivec2(req.a.xy) * VT_PAGE_PAYLOAD - VT_PAGE_BORDER
                   + ivec2(t);
    float scale = float(1u << mip);
    vec2 fin = (vec2(vt_texel) + 0.5) * scale;  // finest-mip texel center

    // ---- resolve owning surface point over the candidate charts ----
    float best_d2 = 1e30;
    uint  best_chart = 0xFFFFFFFFu;
    vec3  best_bary = vec3(1.0, 0.0, 0.0);
    uint  best_tri = 0u;
    bool  inside = false;
    for (uint ci = 0u; ci < req.b.y && !inside; ++ci) {
        uint chart_idx = cand_charts[req.b.x + ci];
        GpuChart c = charts[chart_idx];
        float tpm = c.origin_tpm.w;
        // Invert the chart_atlas.h texel<->position convention:
        //   texel = rect + gutter + (dot(p, T/B) - dot(origin, T/B)) * tpm
        vec2 q = (fin - vec2(c.rect.xy) - float(VT_CHART_GUTTER)) / tpm
               + vec2(c.tangent_ou.w, c.bitangent_ov.w);
        uint first = c.tri_range.x, count = c.tri_range.y;
        for (uint ti = 0u; ti < count; ++ti) {
            GpuTri tr = tris[first + ti];
            vec2 a = vec2(tr.p0.w, tr.n0.w);
            vec2 b = vec2(tr.p1.w, tr.n1.w);
            vec2 cc = vec2(tr.p2.w, tr.n2.w);
            // Cheap reject: plane-space bbox distance vs current best.
            vec2 lo = min(a, min(b, cc)), hi = max(a, max(b, cc));
            vec2 dv = max(max(lo - q, q - hi), vec2(0.0));
            if (dot(dv, dv) >= best_d2) continue;
            vec3 bary;
            float d2 = closest_tri_2d(q, a, b, cc, bary);
            if (d2 < best_d2) {
                best_d2 = d2;
                best_chart = chart_idx;
                best_tri = first + ti;
                best_bary = bary;
                if (d2 <= 0.0) { inside = true; break; }
            }
        }
    }

    if (best_chart == 0xFFFFFFFFu) {
        // No candidates (page over empty atlas space) — neutral fill.
        imageStore(outAlbedo, store_at, vec4(0.5, 0.5, 0.5, 1.0));
        imageStore(outNormal, store_at, vec4(0.5, 0.5, 0.0, 0.0));
        imageStore(outOrm,    store_at, vec4(1.0, 0.8, 0.0, 1.0));
        imageStore(outAux,    store_at, vec4(1.0, 1.0, 0.0, 1.0));
        return;
    }

    GpuChart chart = charts[best_chart];
    GpuTri tri = tris[best_tri];
    vec3 pos = best_bary.x * tri.p0.xyz + best_bary.y * tri.p1.xyz
             + best_bary.z * tri.p2.xyz;
    vec3 nrm = best_bary.x * tri.n0.xyz + best_bary.y * tri.n1.xyz
             + best_bary.z * tri.n2.xyz;
    float nlen = length(nrm);
    nrm = (nlen > 1e-6) ? nrm / nlen : vec3(0.0, 1.0, 0.0);
    vec2 plane_uv = vec2(best_bary.x * tri.p0.w + best_bary.y * tri.p1.w
                             + best_bary.z * tri.p2.w,
                         best_bary.x * tri.n0.w + best_bary.y * tri.n1.w
                             + best_bary.z * tri.n2.w);
    float footprint_m = scale / chart.origin_tpm.w;

    // ---- material weights (seam) + top-2 height blend ----
    uint m0, m1; float w0, w1;
    vt_material_weights(req.b.z, req.b.w, req.debug_params,
                        pos, nrm, tri.mat.x, plane_uv, m0, w0, m1, w1);

    vec3 albedo, orm, dn;
    float blend;
    if (w1 <= 0.0) {
        SurfSample s0 = sample_material(m0, pos, nrm, footprint_m);
        albedo = s0.albedo; orm = s0.orm; dn = s0.delta_n;
        m1 = m0; blend = 0.0;
    } else if (w0 <= 0.0) {
        SurfSample s1 = sample_material(m1, pos, nrm, footprint_m);
        albedo = s1.albedo; orm = s1.orm; dn = s1.delta_n;
        // Dominant aux slot carries the surviving material.
        m0 = m1; blend = 0.0;
    } else {
        SurfSample s0 = sample_material(m0, pos, nrm, footprint_m);
        SurfSample s1 = sample_material(m1, pos, nrm, footprint_m);
        // Height blend: material whose (height + weight) stands taller wins
        // within a fixed blend depth. Passthrough is exact only via the
        // w<=0 branches above (tested identities).
        const float kBlendDepth = 0.2;
        float a0 = s0.height + w0;
        float a1 = s1.height + w1;
        float ma = max(a0, a1) - kBlendDepth;
        float b0 = max(a0 - ma, 0.0);
        float b1 = max(a1 - ma, 0.0);
        blend = b1 / (b0 + b1);
        albedo = mix(s0.albedo, s1.albedo, blend);
        orm    = mix(s0.orm,    s1.orm,    blend);
        dn     = mix(s0.delta_n, s1.delta_n, blend);
    }

    // ---- final normal, re-projected into the chart T/B/N frame ----
    vec3 n_local = normalize(nrm + dn);
    vec3 T = chart.tangent_ou.xyz;
    vec3 B = chart.bitangent_ov.xyz;
    vec3 N = normalize(cross(T, B));
    vec3 ts = vec3(dot(n_local, T), dot(n_local, B), dot(n_local, N));
    // The runtime reconstructs z = sqrt(1 - x^2 - y^2); keep z positive so
    // the BC5 pair stays decodable (cone-limited charts make z >= 0 the
    // overwhelmingly common case anyway).
    if (ts.z < 0.05) { ts.z = 0.05; ts = normalize(ts); }

    imageStore(outAlbedo, store_at, vec4(albedo, 1.0));
    imageStore(outNormal, store_at, vec4(ts.xy * 0.5 + 0.5, 0.0, 0.0));
    imageStore(outOrm,    store_at, vec4(orm, 1.0));
    imageStore(outAux,    store_at,
               vec4(float(m0 & 0xFFu) / 255.0, float(m1 & 0xFFu) / 255.0,
                    blend, 1.0));
}
