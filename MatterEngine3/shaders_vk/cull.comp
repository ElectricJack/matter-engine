#version 460

layout(local_size_x = 64) in;

const uint MAX_LOD = 9u;
const uint ANIMATION_BOUND_SKIN_RASTER = 2u;

struct ClusterMeta {
    vec4 aabb_min_radius;
    vec4 aabb_max_pad;
    float thresholds[MAX_LOD];
    uint lod_mesh_idx[MAX_LOD];
    uint lod_count;
    uint part_slot;
    uint cluster_index;
    uint pad1a;
    uint pad1b;
    uint pad1c;
};

struct GpuInstance {
    mat4 transform;
    mat4 previous_transform;
    uint part_slot;
    uint base_lod;
    uint cluster_start;
    uint cluster_count;
    uint history_valid;
    uint instance_token;
    uint animation_instance_slot;
    uint animation_instance_generation;
};

struct DynamicAnimationBound {
    vec4 aabb_min;
    vec4 aabb_max;
    uint instance_slot;
    uint instance_generation;
    uint cluster_index;
    uint lod;
    uint flags;
    uint pad;
};
// `flags & 1` is the serialized permission for an HZB occlusion test. This
// culling pipeline currently performs frustum/LOD selection only, so both a
// valid dynamic box and a fail-open conservative box participate in that
// test. A future HZB path must consult this flag and must never occlude a
// record with the bit clear.

struct DrawTransform {
    mat4 current;
    mat4 previous;
    uint history_valid;
    uint instance_token;
    uint pad1;
    uint pad2;
};

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
};

layout(set = 0, binding = 0, std140) uniform FrameConstants {
    mat4 world_to_clip;
    mat4 previous_world_to_clip;
    vec4 frustum_planes[6];
    vec4 camera_eye_pixel_budget;
    uvec4 counts;
    uvec4 capacities;
    uvec4 temporal;
} frame;

layout(set = 1, binding = 0, std430) readonly buffer ClusterMetas {
    ClusterMeta clusters[];
};
layout(set = 1, binding = 1, std430) readonly buffer Instances {
    GpuInstance instances[];
};
layout(set = 1, binding = 2, std430) buffer DrawCommands {
    DrawCommand commands[];
};
layout(set = 1, binding = 3, std430) writeonly buffer DrawTransforms {
    DrawTransform draw_transforms[];
};
layout(set = 1, binding = 4, std430) buffer Stats {
    uint frustum_culled;
    uint hiz_culled;
    uint emitted;
    uint overflowed;
    uint triangles;
    uint batches;
};
layout(set = 1, binding = 8, std430) readonly buffer DynamicAnimationBounds {
    DynamicAnimationBound dynamic_animation_bounds[];
};

// Dynamic records are keyed by (instance slot, serialized cluster index, LOD).
// The initial pass unions all available LOD records, which makes the early
// frustum decision conservative even when the chosen LOD has not yet been
// selected. A second exact lookup below tightens it after LOD choice.
bool dynamic_cluster_union(const GpuInstance instance, const ClusterMeta cluster,
                           out vec3 aabb_min, out vec3 aabb_max) {
    if (instance.animation_instance_slot == 0xffffffffu) return false;
    bool found = false;
    aabb_min = vec3(3.402823e38);
    aabb_max = vec3(-3.402823e38);
    // The buffer capacity can be larger than this frame's payload after a
    // prior busy frame. Counts.w is authoritative; never inspect stale tail
    // records, including when this frame has zero animated bounds.
    for (uint i = 0u; i < frame.counts.w; ++i) {
        const DynamicAnimationBound value = dynamic_animation_bounds[i];
        if (value.instance_slot != instance.animation_instance_slot ||
            value.instance_generation != instance.animation_instance_generation ||
            value.cluster_index != cluster.cluster_index) continue;
        aabb_min = min(aabb_min, value.aabb_min.xyz);
        aabb_max = max(aabb_max, value.aabb_max.xyz);
        found = true;
    }
    return found;
}

bool dynamic_cluster_lod(const GpuInstance instance, const ClusterMeta cluster,
                         uint lod, out vec3 aabb_min, out vec3 aabb_max) {
    if (instance.animation_instance_slot == 0xffffffffu) return false;
    for (uint i = 0u; i < frame.counts.w; ++i) {
        const DynamicAnimationBound value = dynamic_animation_bounds[i];
        if (value.instance_slot == instance.animation_instance_slot &&
            value.instance_generation == instance.animation_instance_generation &&
            value.cluster_index == cluster.cluster_index && value.lod == lod) {
            aabb_min = value.aabb_min.xyz;
            aabb_max = value.aabb_max.xyz;
            return true;
        }
    }
    return false;
}

bool uses_skin_raster(const GpuInstance instance, uint lod) {
    if (instance.animation_instance_slot == 0xffffffffu) return false;
    for (uint i = 0u; i < frame.counts.w; ++i) {
        const DynamicAnimationBound value = dynamic_animation_bounds[i];
        if (value.instance_slot == instance.animation_instance_slot &&
            value.instance_generation == instance.animation_instance_generation &&
            value.lod == lod &&
            (value.flags & ANIMATION_BOUND_SKIN_RASTER) != 0u) {
            return true;
        }
    }
    return false;
}

bool reserve_transform_slot(uint bucket, out uint slot) {
    const uint first = commands[bucket].first_instance;
    if (first > frame.capacities.w) return false;
    const uint end = bucket + 1u < frame.capacities.z
                         ? commands[bucket + 1u].first_instance
                         : frame.capacities.w;
    if (end < first || end > frame.capacities.w) return false;
    const uint available = end - first;
    for (;;) {
        const uint current = atomicAdd(commands[bucket].instance_count, 0u);
        if (current >= available) return false;
        const uint observed = atomicCompSwap(commands[bucket].instance_count,
                                             current, current + 1u);
        if (observed == current) {
            slot = current;
            return true;
        }
    }
}

void main() {
    const uint tid = gl_GlobalInvocationID.x;
    if (frame.counts.y == 0u) return;
    const uint instance_index = tid / frame.counts.y;
    const uint local_cluster = tid % frame.counts.y;
    if (instance_index >= frame.counts.x ||
        instance_index >= frame.capacities.y) return;
    const GpuInstance instance = instances[instance_index];
    if (local_cluster >= instance.cluster_count) return;

    if (instance.cluster_start >= frame.capacities.x ||
        local_cluster >= frame.capacities.x - instance.cluster_start) return;
    const uint cluster_index = instance.cluster_start + local_cluster;
    const ClusterMeta cluster = clusters[cluster_index];
    if (cluster.lod_count == 0u || cluster.lod_count > MAX_LOD) return;

    vec3 local_aabb_min = cluster.aabb_min_radius.xyz;
    vec3 local_aabb_max = cluster.aabb_max_pad.xyz;
    const bool dynamic_bound = dynamic_cluster_union(instance, cluster,
                                                      local_aabb_min, local_aabb_max);

    const vec3 sxv = vec3(instance.transform[0][0], instance.transform[0][1],
                          instance.transform[0][2]);
    const vec3 syv = vec3(instance.transform[1][0], instance.transform[1][1],
                          instance.transform[1][2]);
    const vec3 szv = vec3(instance.transform[2][0], instance.transform[2][1],
                          instance.transform[2][2]);
    const float scale = (length(sxv) + length(syv) + length(szv)) / 3.0;
    const vec3 local_center = (local_aabb_min + local_aabb_max) * 0.5;
    const vec3 world_center =
        (instance.transform * vec4(local_center, 1.0)).xyz;
    const float distance_to_eye =
        max(distance(world_center, frame.camera_eye_pixel_budget.xyz), 0.01);
    const float local_radius = dynamic_bound
        ? length(local_aabb_max - local_aabb_min) * 0.5
        : cluster.aabb_min_radius.w;
    const float projected_size = local_radius * scale /
                                 distance_to_eye *
                                 frame.camera_eye_pixel_budget.w;
    uint lod = cluster.lod_count - 1u;
    for (uint i = 0u; i < cluster.lod_count; ++i) {
        if (projected_size >= cluster.thresholds[i]) {
            lod = i;
            break;
        }
    }
    // Tighten from the conservative all-LOD union to the chosen LOD before
    // making any frustum decision. This avoids the bind-pose coarse reject
    // while retaining per-LOD precision once selection is known.
    if (dynamic_bound)
        dynamic_cluster_lod(instance, cluster, lod, local_aabb_min, local_aabb_max);

    vec3 world_corners[8];
    for (int i = 0; i < 8; ++i) {
        const vec3 local_position = vec3(
            (i & 4) != 0 ? local_aabb_max.x : local_aabb_min.x,
            (i & 2) != 0 ? local_aabb_max.y : local_aabb_min.y,
            (i & 1) != 0 ? local_aabb_max.z : local_aabb_min.z);
        world_corners[i] = (instance.transform * vec4(local_position, 1.0)).xyz;
    }

    // The legacy all-corners-outside test is retained. The selected dynamic
    // AABB replaces immutable cluster bounds only when an override exists.
    for (int plane = 0; plane < 6; ++plane) {
        bool all_outside = true;
        for (int i = 0; i < 8; ++i) {
            if (dot(frame.frustum_planes[plane].xyz, world_corners[i]) +
                    frame.frustum_planes[plane].w >= 0.0) {
                all_outside = false;
                break;
            }
        }
        if (all_outside) {
            atomicAdd(frustum_culled, 1u);
            return;
        }
    }

    // The explicit skin raster draw owns only this generational instance.
    // Bind fallbacks and ordinary instances sharing the command's mesh range
    // remain in the static indirect bucket.
    if (uses_skin_raster(instance, lod)) return;

    if (cluster_index > (0xffffffffu - lod) / MAX_LOD) return;
    const uint bucket = cluster_index * MAX_LOD + lod;
    if (bucket >= frame.capacities.z) return;
    uint slot = 0u;
    if (!reserve_transform_slot(bucket, slot)) {
        atomicAdd(overflowed, 1u);
        return;
    }
    const uint first = commands[bucket].first_instance;
    if (first >= frame.capacities.w || slot >= frame.capacities.w - first)
        return;
    draw_transforms[first + slot].current = instance.transform;
    draw_transforms[first + slot].previous = instance.previous_transform;
    draw_transforms[first + slot].history_valid = instance.history_valid;
    draw_transforms[first + slot].instance_token = instance.instance_token;
    atomicAdd(emitted, 1u);
    atomicAdd(triangles, commands[bucket].index_count / 3u);
    if (slot == 0u) atomicAdd(batches, 1u);
}
