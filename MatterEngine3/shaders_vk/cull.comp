#version 460

layout(local_size_x = 64) in;

// WHICH OF THE TWO CULL PASSES THIS PIPELINE IS (M4, same-frame occlusion).
//
//   0 = the ID pass's list. Frustum only, no mask, emit the coarsest rung into
//       vis_commands/vis_draw_transforms, then stop. No stats: pass 1 walks the
//       same clusters and is the only counter, so both writing would double
//       every number the HUD shows.
//   1 = the real draw list. Frustum, then the mask the ID pass just produced.
//
// Two pipelines from one module (a specialization constant, so each folds to a
// straight line and neither pays for the branch). They were ONE dispatch that
// wrote both lists, which forced the mask to be the PREVIOUS frame's -- the
// list feeding the ID pass cannot be built after the pass that consumes its
// answer. Splitting the dispatch is what lets the ID pass sit between them and
// makes the mask same-frame.
layout(constant_id = 0) const uint kCullPass = 1u;

const uint MAX_LOD = 9u;
const uint ANIMATION_BOUND_SKIN_RASTER = 2u;

struct ClusterMeta {
    vec4 aabb_min_radius;
    vec4 aabb_max_pad;
    // Normalized LOD switch distances, fine -> coarse and INCREASING: rung i
    // applies while distance_to_eye <= switch_distances[i] * reach, where
    // reach = local_radius * scale * pixel_budget * lod_bias. Normalized by
    // radius as well as scale/dial because local_radius below is per-instance
    // for a dynamic-bound cluster. See MatterEngine3/src/render/lod_distance.h,
    // which owns the rule and carries the equivalence proof.
    float switch_distances[MAX_LOD];
    uint lod_mesh_idx[MAX_LOD];
    uint lod_count;
    uint part_slot;
    uint cluster_index;
    // The leading MESH-rung count of this cluster's ladder (trailing rungs are
    // impostor billboards; part_flatten appends them after the mesh ladder
    // bottoms out). 0 = billboard-only. The ID pass may only rasterise mesh
    // rungs: visibility_id.vert has no billboard branch, so a card would land
    // in its BAKED object-space orientation, solid -- a wrong-shape occluder.
    uint vis_mesh_lods;
    uint pad1b;
    uint pad1c;
};

struct GpuInstance {
    mat4 transform;
    mat4 previous_transform;
    uint part_slot;
    uint base_lod;
    uint cluster_start;
    uint cluster_count;
    uint history_valid;
    uint instance_token;
    uint animation_instance_slot;
    uint animation_instance_generation;
};

struct DynamicAnimationBound {
    vec4 aabb_min;
    vec4 aabb_max;
    uint instance_slot;
    uint instance_generation;
    uint cluster_index;
    uint lod;
    uint flags;
    uint pad;
};

struct DrawTransform {
    mat4 current;
    mat4 previous;
    uint history_valid;
    uint instance_token;
    // WP-E (chart-space VT): transported vt slot (indirection layer + 1;
    // 0 = this draw has no chart table). Written below from the per-(part,
    // lod) vt_draw_slots table and forwarded flat by raster.vert.
    uint vt_slot;
    // LOD debug view: the rung THIS dispatch selected for this draw, written
    // below and forwarded flat by raster.vert. Repurposes the trailing pad
    // word, so DrawTransform stays 144 bytes.
    uint selected_lod;
};

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int  vertex_offset;
    uint first_instance;
};

layout(set = 0, binding = 0, std140) uniform FrameConstants {
    mat4 world_to_clip;
    mat4 previous_world_to_clip;
    vec4 frustum_planes[6];
    vec4 camera_eye_pixel_budget;
    uvec4 counts;
    uvec4 capacities;
    uvec4 temporal;
    // ---- occlusion ID pass (M4) -------------------------------------------
    // x = cull DRAWS against the visibility mask (0 = the mask is written and
    //     read by nobody, which is the default and the pre-M4 behaviour).
    // yzw unused. y was "emit the ID list at all" back when one dispatch wrote
    // both lists; which list a dispatch writes is now kCullPass, and the
    // renderer simply does not dispatch pass 0 when the cull is off.
    uvec4 vis_params;
} frame;

// The ID pass's UNFILTERED draw list, written here and rasterised by
// visibility_id.vert. Deliberately not the same buffers as `commands` and
// `draw_transforms` below: those are filtered by the mask, and a pass that
// decides visibility from a list already filtered by visibility can never
// let a culled instance back in.
layout(set = 1, binding = 16, std430) buffer VisDrawCommands {
    DrawCommand vis_commands[];
};
layout(set = 1, binding = 17, std430) writeonly buffer VisDrawTransforms {
    DrawTransform vis_draw_transforms[];
};
// Which instance tokens owned a pixel of the ID target THIS frame. Written by
// visible_ids.comp between pass 0 and pass 1, read here, never written here.
layout(set = 1, binding = 18, std430) readonly buffer VisibleMask {
    uint visible_mask[];
};
// Per part slot: 1 = this part's mesh rungs are free of alpha-tested
// materials, so the ID pass's no-discard raster of them cannot overstate what
// the G-buffer will draw. 0 = it can (foliage cutouts), so the part neither
// occludes nor is occlusion-tested -- the ID pass stamping an alpha-tested
// mesh SOLID is exactly how enabling conifers hid the terrain sectors behind
// their see-through canopies. Rebuilt CPU-side with the material table; out of
// range fails toward 1 (the pre-exclusion behaviour), and the CPU pads the
// buffer's capacity tail with 1s because length() is capacity, not payload.
layout(set = 1, binding = 19, std430) readonly buffer PartOccluderClass {
    uint part_occluder[];
};

// render/visibility_hash.h's twin. Keep the expression textually identical:
// uint32 multiplication wraps the same in both, so "the same text" is also
// "the same bits", and a divergence here is a cull that deletes the wrong
// geometry with nothing to report it.
uint visible_id_hash(uint token) {
    return (token * 2654435761u) >> (32u - 19u);
}

layout(set = 1, binding = 0, std430) readonly buffer ClusterMetas {
    ClusterMeta clusters[];
};
layout(set = 1, binding = 1, std430) readonly buffer Instances {
    GpuInstance instances[];
};
layout(set = 1, binding = 2, std430) buffer DrawCommands {
    DrawCommand commands[];
};
layout(set = 1, binding = 3, std430) writeonly buffer DrawTransforms {
    DrawTransform draw_transforms[];
};
layout(set = 1, binding = 4, std430) buffer Stats {
    uint frustum_culled;
    uint occlusion_culled;
    uint emitted;
    uint overflowed;
    uint triangles;
    uint batches;
};
layout(set = 1, binding = 8, std430) readonly buffer DynamicAnimationBounds {
    DynamicAnimationBound dynamic_animation_bounds[];
};
// WP-E: transported vt slots, one per (cluster, lod) bucket -- the same
// cluster_index * MAX_LOD + lod indexing `commands` uses. Always bound (a
// one-entry dummy when the VT runtime never started), so the bounds check
// at the write site is the only gate.
layout(set = 1, binding = 9, std430) readonly buffer VtDrawSlots {
    uint vt_draw_slots[];
};

// Per-module draw overrides (matter/draw_overrides.h), resolved on the CPU to
// one entry per registered PART SLOT -- the only part identity this dispatch
// has. Always bound; when no module carries an override the renderer binds a
// ONE-ENTRY NEUTRAL table {0, 1}, so slot 0 reads a no-op and every other slot
// fails the length() bound. Both guards below are exact-equality tests against
// the neutral value, which is what keeps the default state bit-identical to
// the pre-override shader (no multiply is emitted, no branch is taken).
//
// This is the per-frame enforcement point on purpose: `distance_to_eye` and
// `projected_size` are recomputed here from FrameConstants::camera_eye every
// frame, while the instance buffer upstream is retained across frames.
struct PartDrawOverride {
    float max_draw_distance;   // 0 = unlimited
    float lod_bias;            // 1 = neutral
};
layout(set = 1, binding = 14, std430) readonly buffer PartDrawOverrides {
    PartDrawOverride part_draw_overrides[];
};

// Dynamic records are keyed by (instance slot, serialized cluster index, LOD).
// The initial pass unions all available LOD records, which makes the early
// frustum decision conservative even when the chosen LOD has not yet been
// selected. A second exact lookup below tightens it after LOD choice.
// The AABB parameters are `inout`, not `out`, and are written only when a
// record is actually found. GLSL `out` parameters are uninitialized on entry
// and unconditionally copied back to the caller on return, so an `out` here
// silently destroyed the caller's static cluster AABB on every path that did
// not write one — including the very first early return, which every
// non-animated instance takes (animation_instance_slot == UINT32_MAX is the
// documented static path). The caller then frustum-tested a garbage box built
// from whatever the uninitialized temporary held, which rejected visible
// static geometry and did so nondeterministically from run to run.
bool dynamic_cluster_union(const GpuInstance instance, const ClusterMeta cluster,
                           inout vec3 aabb_min, inout vec3 aabb_max) {
    if (instance.animation_instance_slot == 0xffffffffu) return false;
    bool found = false;
    vec3 union_min = vec3(3.402823e38);
    vec3 union_max = vec3(-3.402823e38);
    // The buffer capacity can be larger than this frame's payload after a
    // prior busy frame. Counts.w is authoritative; never inspect stale tail
    // records, including when this frame has zero animated bounds.
    for (uint i = 0u; i < frame.counts.w; ++i) {
        const DynamicAnimationBound value = dynamic_animation_bounds[i];
        if (value.instance_slot != instance.animation_instance_slot ||
            value.instance_generation != instance.animation_instance_generation ||
            value.cluster_index != cluster.cluster_index) continue;
        union_min = min(union_min, value.aabb_min.xyz);
        union_max = max(union_max, value.aabb_max.xyz);
        found = true;
    }
    // Leave the caller's immutable cluster bounds intact unless this frame
    // really carried an override; the inverted seed above is not a usable box.
    if (!found) return false;
    aabb_min = union_min;
    aabb_max = union_max;
    return true;
}

// `inout` for the same reason as dynamic_cluster_union: the no-record path must
// leave the caller's conservative union in place rather than copy back an
// unwritten temporary.
bool dynamic_cluster_lod(const GpuInstance instance, const ClusterMeta cluster,
                         uint lod, inout vec3 aabb_min, inout vec3 aabb_max) {
    if (instance.animation_instance_slot == 0xffffffffu) return false;
    for (uint i = 0u; i < frame.counts.w; ++i) {
        const DynamicAnimationBound value = dynamic_animation_bounds[i];
        if (value.instance_slot == instance.animation_instance_slot &&
            value.instance_generation == instance.animation_instance_generation &&
            value.cluster_index == cluster.cluster_index && value.lod == lod) {
            aabb_min = value.aabb_min.xyz;
            aabb_max = value.aabb_max.xyz;
            return true;
        }
    }
    return false;
}

bool uses_skin_raster(const GpuInstance instance, const ClusterMeta cluster,
                      uint lod) {
    if (instance.animation_instance_slot == 0xffffffffu) return false;
    for (uint i = 0u; i < frame.counts.w; ++i) {
        const DynamicAnimationBound value = dynamic_animation_bounds[i];
        if (value.instance_slot == instance.animation_instance_slot &&
            value.instance_generation == instance.animation_instance_generation &&
            value.cluster_index == cluster.cluster_index &&
            value.lod == lod &&
            (value.flags & ANIMATION_BOUND_SKIN_RASTER) != 0u) {
            return true;
        }
    }
    return false;
}

// The same reservation against the ID pass's list.// The same reservation against the ID pass's list. A copy rather than a
// parameterised version because GLSL has no buffer references here and the
// alternative is threading a flag through the hot path of the cull to pick
// between two arrays; the bodies are short and identical, and they are
// identical for a reason (the two lists share a command template, so a
// bucket's capacity means the same thing in both).
bool reserve_vis_slot(uint bucket, out uint slot) {
    const uint first = vis_commands[bucket].first_instance;
    if (first > frame.capacities.w) return false;
    const uint end = bucket + 1u < frame.capacities.z
                         ? vis_commands[bucket + 1u].first_instance
                         : frame.capacities.w;
    if (end < first || end > frame.capacities.w) return false;
    const uint available = end - first;
    const uint reserved = atomicAdd(vis_commands[bucket].instance_count, 1u);
    if (reserved >= available) {
        atomicAdd(vis_commands[bucket].instance_count, 0xffffffffu);
        return false;
    }
    slot = reserved;
    return true;
}

bool reserve_transform_slot(uint bucket, out uint slot) {
    const uint first = commands[bucket].first_instance;
    if (first > frame.capacities.w) return false;
    const uint end = bucket + 1u < frame.capacities.z
                         ? commands[bucket + 1u].first_instance
                         : frame.capacities.w;
    if (end < first || end > frame.capacities.w) return false;
    const uint available = end - first;
    // Perf: this used to be an atomicCompSwap retry loop on a single word.
    // Every instance of a part shares its cluster range, so the bucket index is
    // identical for thousands of invocations, which turned the CAS into a spin
    // convoy: with N contenders only one wins per round, so the pass costs
    // O(N^2) atomic round-trips on one cache line.
    //
    // A single atomicAdd reserves a unique index in one round-trip. Invocations
    // that land past the bucket's capacity give the reservation back with a
    // compensating decrement, so the counter settles at exactly
    // min(demand, available) — the same value the CAS loop produced — and the
    // handed-out slots are still the dense range [0, available). Nothing reads
    // instance_count during this dispatch (the indirect draw consumes it only
    // after the compute barrier), so the transient over-count is unobservable,
    // and it cannot wrap: demand is bounded by instance_count * cluster_count.
    //
    // Overflow signalling is unchanged: returning false makes the caller bump
    // the `overflowed` stat and drop the instance, and a failing invocation
    // still never writes a draw transform.
    const uint reserved = atomicAdd(commands[bucket].instance_count, 1u);
    if (reserved >= available) {
        // Wrapping add of -1: uint atomics are modular, so this is an exact
        // undo of this invocation's reservation.
        atomicAdd(commands[bucket].instance_count, 0xffffffffu);
        return false;
    }
    slot = reserved;
    return true;
}

void main() {
    const uint tid = gl_GlobalInvocationID.x;
    if (frame.counts.y == 0u) return;
    const uint instance_index = tid / frame.counts.y;
    const uint local_cluster = tid % frame.counts.y;
    if (instance_index >= frame.counts.x ||
        instance_index >= frame.capacities.y) return;
    const GpuInstance instance = instances[instance_index];
    if (local_cluster >= instance.cluster_count) return;

    if (instance.cluster_start >= frame.capacities.x ||
        local_cluster >= frame.capacities.x - instance.cluster_start) return;
    const uint cluster_index = instance.cluster_start + local_cluster;
    const ClusterMeta cluster = clusters[cluster_index];
    if (cluster.lod_count == 0u || cluster.lod_count > MAX_LOD) return;

    vec3 local_aabb_min = cluster.aabb_min_radius.xyz;
    vec3 local_aabb_max = cluster.aabb_max_pad.xyz;
    const bool dynamic_bound = dynamic_cluster_union(instance, cluster,
                                                      local_aabb_min, local_aabb_max);

    const vec3 sxv = vec3(instance.transform[0][0], instance.transform[0][1],
                          instance.transform[0][2]);
    const vec3 syv = vec3(instance.transform[1][0], instance.transform[1][1],
                          instance.transform[1][2]);
    const vec3 szv = vec3(instance.transform[2][0], instance.transform[2][1],
                          instance.transform[2][2]);
    const float scale = (length(sxv) + length(syv) + length(szv)) / 3.0;
    const vec3 local_center = (local_aabb_min + local_aabb_max) * 0.5;
    const vec3 world_center =
        (instance.transform * vec4(local_center, 1.0)).xyz;
    const float distance_to_eye =
        max(distance(world_center, frame.camera_eye_pixel_budget.xyz), 0.01);
    const float local_radius = dynamic_bound
        ? length(local_aabb_max - local_aabb_min) * 0.5
        : cluster.aabb_min_radius.w;
    // Per-module draw overrides. max_draw_distance rejects before any LOD work
    // (it is a visibility decision, counted with the other culled clusters);
    // lod_bias scales the projected size exactly where the global pixel budget
    // does, so the selection loop below is untouched.
    float override_lod_bias = 1.0;
    if (cluster.part_slot < part_draw_overrides.length()) {
        const PartDrawOverride ov = part_draw_overrides[cluster.part_slot];
        if (ov.max_draw_distance > 0.0 &&
            distance_to_eye > ov.max_draw_distance) {
            if (kCullPass == 1u) atomicAdd(frustum_culled, 1u);
            return;
        }
        override_lod_bias = ov.lod_bias;
    }
    // lod_distance.h: reach turns a normalized switch distance into metres.
    float reach = local_radius * scale * frame.camera_eye_pixel_budget.w;
    if (override_lod_bias != 1.0) reach *= override_lod_bias;
    uint lod = cluster.lod_count - 1u;
    for (uint i = 0u; i < cluster.lod_count; ++i) {
        // isinf mirrors lod_distance.h::select_rep. An OPEN rung (threshold <= 0,
        // "always qualifies") is an infinite switch distance, and a zero reach --
        // a degenerate zero-radius cluster -- makes inf * 0 a NaN that compares
        // false, silently skipping it. Keep the two implementations of the rule
        // identical here, or the CPU mirror and the GPU disagree in exactly the
        // case neither is tested on.
        const float limit = cluster.switch_distances[i];
        if (isinf(limit) || distance_to_eye <= limit * reach) {
            lod = i;
            break;
        }
    }
    // Tighten from the conservative all-LOD union to the chosen LOD before
    // making any frustum decision. This avoids the bind-pose coarse reject
    // while retaining per-LOD precision once selection is known.
    if (dynamic_bound)
        dynamic_cluster_lod(instance, cluster, lod, local_aabb_min, local_aabb_max);

    vec3 world_corners[8];
    for (int i = 0; i < 8; ++i) {
        const vec3 local_position = vec3(
            (i & 4) != 0 ? local_aabb_max.x : local_aabb_min.x,
            (i & 2) != 0 ? local_aabb_max.y : local_aabb_min.y,
            (i & 1) != 0 ? local_aabb_max.z : local_aabb_min.z);
        world_corners[i] = (instance.transform * vec4(local_position, 1.0)).xyz;
    }

    // The legacy all-corners-outside test is retained. The selected dynamic
    // AABB replaces immutable cluster bounds only when an override exists.
    for (int plane = 0; plane < 6; ++plane) {
        bool all_outside = true;
        for (int i = 0; i < 8; ++i) {
            if (dot(frame.frustum_planes[plane].xyz, world_corners[i]) +
                    frame.frustum_planes[plane].w >= 0.0) {
                all_outside = false;
                break;
            }
        }
        if (all_outside) {
            if (kCullPass == 1u) atomicAdd(frustum_culled, 1u);
            return;
        }
    }

    // ---- occlusion eligibility (M4 follow-up) ------------------------------
    //
    // A cluster takes part in occlusion -- both sides of it -- only when the
    // ID pass can rasterise it HONESTLY. Two ways it cannot: a billboard rung
    // (visibility_id.vert has no impostor branch, so the card lands in its
    // baked orientation, solid), and alpha-tested materials (the ID pass has
    // no discard by design, so a cutout mesh stamps its full silhouette while
    // the G-buffer draw shows through it). Either one turns "occluder" into
    // "wall", and the sectors behind a conifer hillside read occluded while
    // the real draw is see-through. Such clusters are excluded from the ID
    // list AND exempted from the mask test below: they can never register
    // their token, so testing them would cull them unconditionally.
    const bool occlusion_eligible =
        cluster.vis_mesh_lods > 0u &&
        (cluster.part_slot < part_occluder.length()
             ? part_occluder[cluster.part_slot] != 0u
             : true);

    // ---- pass 0: the ID pass's list (M4) -----------------------------------
    //
    // NEVER mask-tested, which is the whole design. This list is what the ID
    // pass rasterises to decide who is visible; filtering it by the previous
    // answer would mean a sector culled once is never tested again and never
    // comes back. Everything that survives the frustum lands here.
    //
    // At the COARSEST rung, because this list exists to answer a yes/no
    // question into a target a fraction of the size -- the fine mesh would
    // cost vertex work to produce the same answer.
    if (kCullPass == 0u) {
        if (!occlusion_eligible) return;
        // COARSEST *mesh* rung, and "coarsest" is measured rather than
        // assumed. The selected rung rejects about 10% more clusters --
        // inside a cavern, 83 against 74 -- because a decimated proxy is a
        // slightly leakier occluder. It also costs the ID pass the full
        // vertex work of the un-culled set, and that wipes out the entire
        // win: same camera, same process,
        //
        //   coarsest   8.69 ms -> 7.36 ms   (-15%)
        //   selected   8.63 ms -> 8.62 ms   (nothing)
        //
        // A cheap approximate occluder beats an exact expensive one here,
        // which is the whole reason this pass can afford to run every frame.
        // Clamped under vis_mesh_lods so a trailing billboard rung is never
        // the proxy (see occlusion_eligible above).
        const uint vis_lod = min(cluster.vis_mesh_lods, cluster.lod_count) - 1u;
        if (cluster_index <= (0xffffffffu - vis_lod) / MAX_LOD) {
            const uint vis_bucket = cluster_index * MAX_LOD + vis_lod;
            uint vis_slot = 0u;
            if (vis_bucket < frame.capacities.z &&
                reserve_vis_slot(vis_bucket, vis_slot)) {
                const uint vis_first = vis_commands[vis_bucket].first_instance;
                if (vis_first < frame.capacities.w &&
                    vis_slot < frame.capacities.w - vis_first) {
                    // Only the two fields visibility_id.vert reads. The rest of
                    // the record is left alone: it is never sampled, and
                    // writing it would be bandwidth spent on a pass whose
                    // entire point is being cheap.
                    vis_draw_transforms[vis_first + vis_slot].current =
                        instance.transform;
                    vis_draw_transforms[vis_first + vis_slot].instance_token =
                        instance.instance_token;
                }
            }
        }
        // Pass 0 emits nothing else. The main list is pass 1's, and it runs
        // after the ID pass has turned this list into a mask.
        return;
    }

    // ---- the mask (M4) -----------------------------------------------------
    //
    // THIS frame's answer about this instance: pass 0, the ID raster and the
    // reduce all ran earlier in this command buffer, and the barrier before
    // this dispatch makes their writes visible here. It used to be the
    // previous frame's, which showed up as sectors popping in a beat late
    // under fast camera motion.
    //
    // Only for clusters the ID pass could have rasterised. An excluded
    // cluster (billboard terminal, alpha-tested foliage) falls open to
    // frustum-only visibility -- the failure direction that costs draw work,
    // never coverage.
    if (occlusion_eligible && frame.vis_params.x != 0u) {
        const uint bit = visible_id_hash(instance.instance_token);
        if ((visible_mask[bit >> 5u] & (1u << (bit & 31u))) == 0u) {
            atomicAdd(occlusion_culled, 1u);
            return;
        }
    }

    // The explicit skin raster draw owns only this generational instance.
    // Bind fallbacks and ordinary instances sharing the command's mesh range
    // remain in the static indirect bucket.
    if (uses_skin_raster(instance, cluster, lod)) return;

    if (cluster_index > (0xffffffffu - lod) / MAX_LOD) return;
    const uint bucket = cluster_index * MAX_LOD + lod;
    if (bucket >= frame.capacities.z) return;
    uint slot = 0u;
    if (!reserve_transform_slot(bucket, slot)) {
        atomicAdd(overflowed, 1u);
        return;
    }
    const uint first = commands[bucket].first_instance;
    if (first >= frame.capacities.w || slot >= frame.capacities.w - first)
        return;
    draw_transforms[first + slot].current = instance.transform;
    draw_transforms[first + slot].previous = instance.previous_transform;
    draw_transforms[first + slot].history_valid = instance.history_valid;
    draw_transforms[first + slot].instance_token = instance.instance_token;
    // WP-E: the vt slot table is indexed exactly like `commands` -- one entry
    // per (cluster, lod) bucket. Fail closed: an out-of-range bucket (dummy
    // buffer, or a table that has not caught up with a just-registered part)
    // means "no VT" and the fragment shader takes the legacy path.
    draw_transforms[first + slot].vt_slot =
        bucket < vt_draw_slots.length() ? vt_draw_slots[bucket] : 0u;
    draw_transforms[first + slot].selected_lod = lod;
    atomicAdd(emitted, 1u);
    atomicAdd(triangles, commands[bucket].index_count / 3u);
    if (slot == 0u) atomicAdd(batches, 1u);
}
