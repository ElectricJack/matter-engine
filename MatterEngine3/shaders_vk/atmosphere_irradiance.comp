#version 460
#include "atmosphere_common.glsl"
layout(local_size_x=1, local_size_y=1, local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D sky_view_tex;
layout(set=0,binding=3,rgba16f) uniform writeonly image2D irradiance_out;
float sh(int index, vec3 d) {
    if (index == 0) return 0.282095;
    if (index == 1) return 0.488603*d.y;
    if (index == 2) return 0.488603*d.z;
    if (index == 3) return 0.488603*d.x;
    if (index == 4) return 1.092548*d.x*d.y;
    if (index == 5) return 1.092548*d.y*d.z;
    if (index == 6) return 0.315392*(3.0*d.z*d.z-1.0);
    if (index == 7) return 1.092548*d.x*d.z;
    return 0.546274*(d.x*d.x-d.y*d.y);
}
void main() {
    for (int coefficient=0; coefficient<9; ++coefficient) {
        vec3 sum=vec3(0.0), compensation=vec3(0.0);
        for (int y=0; y<16; ++y) for (int x=0; x<32; ++x) {
            float phi = -ATM_PI + 2.0*ATM_PI*(float(x)+0.5)/32.0;
            float theta = ATM_PI*(float(y)+0.5)/16.0;
            vec3 direction=vec3(sin(theta)*cos(phi),cos(theta),sin(theta)*sin(phi));
            float solid_angle=(2.0*ATM_PI/32.0)*(ATM_PI/16.0)*sin(theta);
            vec3 term=texture(sky_view_tex, vec2((phi+ATM_PI)/(2.0*ATM_PI),theta/ATM_PI)).rgb *
                      sh(coefficient,direction) * solid_angle;
            vec3 adjusted=term-compensation; vec3 next=sum+adjusted;
            compensation=(next-sum)-adjusted; sum=next;
        }
        imageStore(irradiance_out, ivec2(coefficient % 3, coefficient / 3), vec4(sum,1.0));
    }
}
