#version 450
#include "solid_field.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 2) writeonly buffer Field {
    float field[];
};
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= dims.w)
        return;
    field[i] =
        solidField(origin.xyz + spacing.xyz * vec3(solidCoordinate(i, dims.xyz)));
}
