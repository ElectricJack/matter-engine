#version 460

// Phase C2 deformation contract. Dispatch (ceil(max vertices / 64), workCount,
// 1); each work item's explicit ranges keep unrelated meshes isolated.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct SourceVertex {
    vec4 position;
    vec4 normal;
    vec4 tint;
    vec4 surface;
    uint material_index;
    // Do not use uvec3 here: std430 gives it 16-byte base alignment and
    // silently changes this record's array stride to 96 bytes. The C++ ABI is
    // intentionally five vec4 lanes (80 bytes), so retain scalar padding.
    uint pad0, pad1, pad2;
};
struct Influence { uvec4 joint_weight_lo; uvec4 weight_joint_hi; };
// C++ VkSkinInfluence is four u16 joints followed by four u16 weights. GLSL
// scalar layout is not universally enabled, so decode the packed uint lanes.
struct Joint { mat4 position; mat4 normal; };
struct WorkItem {
    uint source_vertex, influence, vertex_count, palette;
    uint output_current, output_previous, instance_slot, flags;
};
struct SkinnedVertex {
    vec4 position;
    vec4 previous_position;
    vec4 normal;
    vec4 tint;
    vec4 surface;
    uint material_index;
    // Same scalar-padding requirement as SourceVertex: VkSkinVertex is 96
    // bytes, with the three trailing words immediately following material.
    uint pad0, pad1, pad2;
};

layout(set = 2, binding = 0, std430) readonly buffer Sources { SourceVertex source[]; };
layout(set = 2, binding = 1, std430) readonly buffer Influences { uint influence_words[]; };
layout(set = 2, binding = 2, std430) readonly buffer CurrentPalettes { Joint current_palette[]; };
layout(set = 2, binding = 3, std430) readonly buffer PreviousPalettes { Joint previous_palette[]; };
layout(set = 2, binding = 4, std430) readonly buffer WorkQueue { WorkItem work[]; };
layout(set = 2, binding = 5, std430) writeonly buffer CurrentOutput { SkinnedVertex current_output[]; };
layout(set = 2, binding = 6, std430) writeonly buffer PreviousOutput { SkinnedVertex previous_output[]; };
layout(push_constant) uniform Dispatch { uint work_count; } dispatch;

uint u16_at(uint word, bool high) { return high ? (word >> 16u) : (word & 65535u); }
void main() {
    uint work_index = gl_WorkGroupID.y;
    uint local_vertex = gl_GlobalInvocationID.x;
    if (work_index >= dispatch.work_count) return;
    WorkItem item = work[work_index];
    if (local_vertex >= item.vertex_count) return;
    uint palette_count = item.flags >> 16u;
    if (palette_count == 0u) return;
    SourceVertex input_vertex = source[item.source_vertex + local_vertex];
    uint influence_offset = (item.influence + local_vertex) * 4u;
    vec4 current_position = vec4(0.0);
    vec4 previous_position = vec4(0.0);
    vec3 current_normal = vec3(0.0);
    for (uint lane = 0u; lane != 4u; ++lane) {
        uint packed_joint = influence_words[influence_offset + lane / 2u];
        uint packed_weight = influence_words[influence_offset + 2u + lane / 2u];
        uint joint = u16_at(packed_joint, (lane & 1u) != 0u);
        float weight = float(u16_at(packed_weight, (lane & 1u) != 0u)) / 65535.0;
        if (weight == 0.0) continue;
        // CPU submission validation rejects this case.  Retain this guard in
        // the shader because stale/corrupt GPU work must never turn into an
        // out-of-bounds SSBO palette read.
        if (joint >= palette_count) return;
        current_position += (current_palette[item.palette + joint].position * vec4(input_vertex.position.xyz, 1.0)) * weight;
        previous_position += (previous_palette[item.palette + joint].position * vec4(input_vertex.position.xyz, 1.0)) * weight;
        current_normal += (current_palette[item.palette + joint].normal * vec4(input_vertex.normal.xyz, 0.0)).xyz * weight;
    }
    SkinnedVertex out_vertex;
    out_vertex.position = current_position;
    out_vertex.previous_position = previous_position;
    out_vertex.normal = vec4(normalize(current_normal), 0.0);
    out_vertex.tint = input_vertex.tint;
    out_vertex.surface = input_vertex.surface;
    out_vertex.material_index = input_vertex.material_index;
    out_vertex.pad0 = out_vertex.pad1 = out_vertex.pad2 = 0u;
    current_output[item.output_current + local_vertex] = out_vertex;
    // Raster binds this second stream at location 5.  Keep its primary
    // position explicitly previous so the vertex fetch cannot accidentally
    // read the current stream's auxiliary field after a binding change.
    SkinnedVertex previous_vertex = out_vertex;
    previous_vertex.position = previous_position;
    previous_output[item.output_previous + local_vertex] = previous_vertex;
}
