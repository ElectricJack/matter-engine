#version 460
#extension GL_EXT_ray_query : require

// vt_dirocc.comp — M6.5 DIRECTIONAL occlusion from impostored casters.
//
// THE PROBLEM. An impostor cannot cast a correct shadow: it is a camera-facing
// card, so the silhouette the light sees is not the one the camera sees, and
// its plane passes through the object's centre so a traced ray starts inside
// the volume it depicts (measured: clamping RT to the mesh rung instead
// darkened the card 10x). M2.5 therefore ships impostors as non-tracing, and a
// tree loses its shadow the moment it impostors.
//
// THE RESOLUTION is to move the bake to the other end of the shadow: do not
// bake into the CASTER's page (pages are keyed per part variant, so every pine
// in the world would share one shadow) — bake into the RECEIVER's. A terrain
// sector is its own part with exactly one placement, so world-context data is
// legitimately correct there.
//
// WHY THIS IS NOT A MODE OF vt_enrich_ao.comp. That pass is a CONTACT term: it
// caps rays at ~0.5 m and its strength fades to zero once a page texel is wider
// than the cap — at which point the residency layer stops queueing those pages
// entirely. Coarse far-field pages, which are exactly where impostored props
// live, are never enriched at all. Adding casters there would have added them
// to a pass that is never dispatched. The two are queued by OPPOSITE rules:
//
//   vt_enrich_ao   fine pages,   footprint <= max_footprint_meters()
//   vt_dirocc      coarse pages, footprint >= dir_occ_min_footprint_meters()
//
// WHAT IT WRITES, and why it is directional. A scalar occlusion term is
// sun-INDEPENDENT darkening; a shadow has to move when the sun does. So each
// texel stores a BENT NORMAL (the mean unoccluded direction) plus an APERTURE
// (how open the unoccluded cone is). At runtime gbuffer.frag turns the angle
// between the sun and the bent normal, against that aperture, into
// horizon_sun_visibility — which rt_shadow.rgen already multiplies into traced
// sun visibility. The sun therefore stays a live property; nothing about the
// lighting is baked, only the OCCLUDER's geometry.
//
// OVERWRITE, NOT READ-MODIFY-WRITE. The AO pass multiplies into an existing
// channel, which is what forces its once-only per-slot tier bookkeeping. This
// one owns kVtChannelDirOcc outright, so re-running is idempotent and
// convergent — and that is precisely what makes "re-bake when a caster streams
// in" a non-issue rather than a correctness problem.
//
// DETERMINISM: identical seeding discipline to the AO pass — the VIRTUAL atlas
// texel at this mip, the mip index, and a fixed constant seed. No time, no
// frame counter, no atomics. The caster SET is folded into the page's content
// key by the CPU side, so a bake against two casters is never confused with one
// against three: a different loaded set is a different key, not nondeterminism.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "vt_chart_types.glsl"

#define VT_POOL_LAYER_EDGE 2176.0

// ---- set 0: the RECEIVER's chart/triangle streams, and the CASTER TLAS.
//
// Note binding 2 is the caster TLAS, not the receiver's own. Casters need no
// chart table: the occlusion query below is terminate-on-first-hit and reads no
// per-triangle attributes, which is why they can be borrowed straight from the
// scene's geometry buffers instead of being copied and charted.
layout(std430, set = 0, binding = 0) readonly buffer ChartsBuf { GpuChart charts[]; };
layout(std430, set = 0, binding = 1) readonly buffer TrisBuf   { GpuTri tris[]; };
layout(set = 0, binding = 2) uniform accelerationStructureEXT caster_tlas;

// ---- set 1: per-batch resources -------------------------------------------
struct GpuDirOccRequest {
    uvec4 a;   // x page_x, y page_y, z mip, w out_layer (intermediate)
    uvec4 b;   // x cand_offset, y cand_count, z sample_count, w seed
    uvec4 c;   // x slot_origin_x, y slot_origin_y, z pool_layer, w unused
    vec4  d;   // x reach_meters, y bias_scale, z unused, w unused
};

layout(std430, set = 1, binding = 0) readonly buffer RequestBuf {
    GpuDirOccRequest requests[];
};
layout(std430, set = 1, binding = 1) readonly buffer CandBuf { uint cand_charts[]; };
layout(set = 1, binding = 2) uniform sampler2DArray poolDirOcc;   // unused; see note
layout(set = 1, binding = 3, rgba8) uniform writeonly image2DArray outDirOcc;

layout(push_constant) uniform Push { uint req_index; } pc;

#include "vt_chart_resolve.glsl"

uint splitmix32(uint x) {
    x += 0x9E3779B9u;
    x = (x ^ (x >> 16)) * 0x85EBCA6Bu;
    x = (x ^ (x >> 13)) * 0xC2B2AE35u;
    return x ^ (x >> 16);
}
float u01(uint h) { return float(h & 0x00FFFFFFu) / 16777216.0; }

vec3 cosine_hemi(vec2 uv) {
    float r = sqrt(uv.x);
    float phi = 6.28318530718 * uv.y;
    float x = r * cos(phi);
    float z = r * sin(phi);
    float y = sqrt(max(0.0, 1.0 - uv.x));
    return vec3(x, y, z);
}

mat3 make_basis(vec3 n) {
    vec3 t = abs(n.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 b = normalize(cross(t, n));
    vec3 tt = cross(n, b);
    return mat3(b, n, tt);
}

bool occludeQuery(vec3 P, vec3 dir, float maxRayDist) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, caster_tlas,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
        0xFFu,
        P, 0.0,
        dir, maxRayDist);
    rayQueryProceedEXT(rq);
    return rayQueryGetIntersectionTypeEXT(rq, true) !=
           gl_RayQueryCommittedIntersectionNoneEXT;
}

// "No occlusion", in the channel's encoding: bent normal = the surface normal
// itself and a fully open aperture. Written for every texel this pass cannot
// resolve, so an unresolvable texel reads exactly as an unshadowed one — the
// same fail-open discipline that makes gbuffer.frag's horizon_sun_visibility
// free for every fragment that does not write it.
vec4 encode_open(vec3 n) {
    return vec4(n * 0.5 + 0.5, 1.0);
}

void main() {
    uvec2 t = gl_GlobalInvocationID.xy;
    if (t.x >= uint(VT_PAGE_STORE) || t.y >= uint(VT_PAGE_STORE)) return;
    GpuDirOccRequest req = requests[pc.req_index];
    ivec3 store_at = ivec3(ivec2(t), int(req.a.w));

    uint mip = req.a.z;
    VtSurfacePoint sp =
        vt_resolve_page_texel(t, req.a.xy, mip, req.b.x, req.b.y);
    if (!sp.found) {
        imageStore(outDirOcc, store_at, encode_open(vec3(0.0, 1.0, 0.0)));
        return;
    }

    // GEOMETRIC normal, for the same reason the AO pass uses one: interpolated
    // terrain normals are analytic field gradients that carry finer detail than
    // the mesh, so a hemisphere built around them tilts rays below the actual
    // triangle plane. That produced the sun-averted-slope blackout once already
    // (2026-07-29); do not build the frame from sp.nrm.
    GpuTri own = tris[sp.tri];
    vec3 face_n = cross(own.p1.xyz - own.p0.xyz, own.p2.xyz - own.p0.xyz);
    float face_len = length(face_n);
    vec3 trace_n = (face_len > 1e-12) ? face_n / face_len : sp.nrm;
    if (dot(trace_n, sp.nrm) < 0.0) trace_n = -trace_n;

    float reach = max(req.d.x, 1e-3);
    float bias = max(1e-3, req.d.y * reach);
    vec3 P = sp.pos + trace_n * bias;
    mat3 F = make_basis(trace_n);

    ivec2 vt_texel = ivec2(req.a.xy) * VT_PAGE_PAYLOAD - VT_PAGE_BORDER
                   + ivec2(t);
    uint local_x = uint(vt_texel.x);
    uint local_y = uint(vt_texel.y);
    uint mip_salt = mip * 0x9E3779B9u;

    int samples = int(max(req.b.z, 1u));
    // Accumulate the mean UNOCCLUDED direction. Summing the directions that
    // reached the sky (rather than counting hits) is what makes this
    // directional at all: the resultant vector points away from the occluder,
    // and its length relative to the sample count is how open the cone is.
    vec3 bent = vec3(0.0);
    int  open_count = 0;
    for (int i = 0; i < samples; ++i) {
        uint h1 = splitmix32(local_x * 73856093u ^ local_y * 19349663u
                             ^ uint(i) * 83492791u ^ mip_salt ^ req.b.w);
        uint h2 = splitmix32(h1);
        vec2 uv = vec2(u01(h1), u01(h2));
        vec3 dir = F * cosine_hemi(uv);
        if (!occludeQuery(P, dir, reach)) {
            bent += dir;
            ++open_count;
        }
    }

    if (open_count == 0) {
        // Fully enclosed: no unoccluded direction exists. Keep the geometric
        // normal as the axis (an arbitrary one would make the runtime dot
        // product meaningless) and close the aperture completely.
        imageStore(outDirOcc, store_at, vec4(trace_n * 0.5 + 0.5, 0.0));
        return;
    }
    float bent_len = length(bent);
    vec3 axis = (bent_len > 1e-6) ? bent / bent_len : trace_n;

    // APERTURE = the unoccluded fraction. Stored rather than derived at runtime
    // because it is what distinguishes "a narrow gap in one direction" from "a
    // wide open sky", which is the difference between a hard shadow edge and no
    // shadow at all, and both can share the same bent normal.
    float aperture = float(open_count) / float(samples);

    imageStore(outDirOcc, store_at, vec4(axis * 0.5 + 0.5, aperture));
}
