render_path native_rt
set render.gi.diffuse_multiplier 1
set render.lighting.emission_multiplier 1
set render.lighting.exposure_ev 0

cam 5.8 3.2 7.4 1.5 1.30 1.05
set render.gi.enabled false
history_reset
wait_frames 96
shot C:/tmp/local-light-rt-reopen-f949/corner-gi-off.png
set render.gi.enabled true
history_reset
wait_frames 96
shot C:/tmp/local-light-rt-reopen-f949/corner-gi-on.png

cam 14.0 2.85 6.2 13.5 1.45 0.1
set render.gi.enabled false
history_reset
wait_frames 96
shot C:/tmp/local-light-rt-reopen-f949/materials-gi-off.png
set render.gi.enabled true
history_reset
wait_frames 96
shot C:/tmp/local-light-rt-reopen-f949/materials-gi-on.png

cam 12.8 3.1 5.5 11.5 1.8 1.0
set render.gi.enabled true
set render.lighting.emission_multiplier 1
history_reset
wait_frames 96
shot C:/tmp/local-light-rt-reopen-f949/proxy-visible.png
set render.lighting.emission_multiplier 0
history_reset
wait_frames 96
shot C:/tmp/local-light-rt-reopen-f949/proxy-hidden.png
set render.lighting.emission_multiplier 1
quit
