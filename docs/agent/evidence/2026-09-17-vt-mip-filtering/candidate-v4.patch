+// atlas dimensions can straddle a parent cut, so px/2 alone is insufficient.
+// At most two pages per axis overlap; integer ratios keep edge ownership exact.
+inline uint32_t vt_filter_parent_pages(const VtVariantLayout& layout,VtPageKey page,
