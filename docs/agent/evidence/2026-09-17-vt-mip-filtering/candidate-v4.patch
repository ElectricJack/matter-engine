+#pragma once
+#include "vt_module_residency_tests.h"
+
+namespace vt_filtering_tests {
+inline bool run_impl(matter::VulkanDevice& vk,std::string& error) {
+    vt_queue_tests::Budgets budgets;
+    vt::VtResidency residency;vt_queue_tests::Frames frames(vk);uint64_t serial=0;
+    if(!frames.valid() || !residency.init(vk,error))return false;
+    auto producer=vt::VtCompositor::create(vk.device(),vk.physical_device(),VK_NULL_HANDLE,error);
+    if(!producer)return false;
+    vt::VtCompositorMaterial materials[2]{};producer->set_materials(materials,2);
+    residency.set_filler(std::move(producer));
+    // Deliberately different, constant material at each physical footprint.
+    // Endpoints come from the real compressed pool, isolating interpolation
+    // from codec quantization. Height remains in metres throughout.
+    const std::string tape="footprint\nconst 24\nmul r0 r1\nconst 0.8\nconst 0\nconst 1\n"
+        "const -0.5\nmul r0 r6\nmaterial 1 r5\nsource 1 r2 r2 r2 r3 r4 r5 r7 -0.03 0\n";
+    const gpu_meshing::FaceFrame frame{{0,0,0},{1,0,0},{0,1,0},{0,0,1}};
+    vt::VtPeriodicDomain domain;std::shared_ptr<const vt::VtPartSnapshot> input;
+    if(!vt::vt_make_periodic_domain(frame,{2,1},128,domain,error) ||
+       !vt::vt_make_periodic_material(domain,{},tape,1,input,error))return false;
+    vt::VtMaterialModuleLease module;if(!residency.acquire_material_module(input,module,error))return false;
+    const auto advance=[&]{return frames.next(residency,++serial);};
+    if(!vt_prepare_tests::until([&]{return advance() && residency.material_module_binding(module).slot;}))return false;
+    const auto binding=residency.material_module_binding(module);
+    vt_module_residency_tests::Sampler sampler;if(!sampler.init(vk,residency,error))return false;
+    vt_material_domain_tests::Probe probe{};
+    probe.uv[0]=probe.uv[1]=probe.uv[2]=probe.uv[3]=.4f;
+    probe.slots[0]=probe.slots[1]=binding.slot;probe.slots[2]=binding.generation;
+    using Result=vt_material_domain_tests::Result;
+    const auto sample=[&](float lod,Result& result) {
+        probe.derivatives[0]=std::exp2(lod)/256;probe.derivatives[3]=std::exp2(lod)/128;
+        return sampler.sample_probe(vk,residency,frames,serial,probe,result,error);
+    };
+    Result tail;if(!sample(0,tail))return false;
+    CHECK(tail.metrics[2]==2,"filtering: native compositor starts from a valid tail");
+    const vt::VtFeedbackRequest demand{binding.slot-1,0,0,0};
+    residency.inject_feedback_for_test(&demand,1);
+    if(!vt_prepare_tests::until([&]{return advance() &&
+        residency.resident_page_slot_for_test(binding.slot,{0,0,0})!=UINT32_MAX &&
+        residency.resident_page_slot_for_test(binding.slot,{1,0,0})!=UINT32_MAX;})) {
+        error="visible fine demand failed to produce both filtering levels";return false;
+    }
+    CHECK(residency.stats().fills_total==3,"filtering: one visible request fills fine and upper pages beside the pinned tail");
+    Result fine,upper;if(!sample(0,fine) || !sample(1,upper))return false;
+    CHECK(fine.metrics[2]==0 && upper.metrics[2]==1 &&
+        std::abs(fine.channels[0][0]-upper.channels[0][0])>.1f &&
+        std::abs(fine.metrics[0]-upper.metrics[0])>.003f,"filtering: distinct generated endpoints exercise color and metre height");
+    float max_error=0;
+    for(float lod:{.001f,.125f,.25f,.5f,.75f,.999f}) {
+        Result result;if(!sample(lod,result))return false;
+        for(int ch:{0,2,4})for(int c=0;c<3;++c)
+            max_error=std::max(max_error,std::abs(result.channels[ch][c]-
+                (fine.channels[ch][c]*(1-lod)+upper.channels[ch][c]*lod)));
+        max_error=std::max(max_error,std::abs(result.metrics[0]-(fine.metrics[0]*(1-lod)+upper.metrics[0]*lod)));
+        CHECK(result.material_request[3]==0,"filtering: fractional sampling retains original visible fine demand");
+    }
+    CHECK(max_error<.00002f,"filtering: real compressed color/ORM/height vary continuously through fractional LODs");
+    const auto fills=residency.stats().fills_total;
+    for(int i=0;i<6;++i){residency.inject_feedback_for_test(&demand,1);if(!advance())return false;}
+    CHECK(residency.stats().fills_total==fills && residency.stats().queue_depth==0 &&
+        residency.queued_requests_consistent_for_test(),"filtering: repeated demand retains both levels without regeneration or backlog");
+    std::printf("VT_FILTERING fine_color=%.6f upper_color=%.6f fine_height_m=%.8f upper_height_m=%.8f max_error=%.9f fills=%llu\n",
+        fine.channels[0][0],upper.channels[0][0],fine.metrics[0],upper.metrics[0],max_error,
+        static_cast<unsigned long long>(fills));
+    return true;
+}
+inline void run(matter::VulkanDevice& vk) {
+    std::string error;CHECK(run_impl(vk,error),error.empty()?"native mip filtering":error.c_str());
+    CHECK(vk.validation_error_count()==0,"filtering: zero Vulkan validation errors");
+}
