+static void test_filter_parent_coverage() {
+    // Independently sample normalized positions throughout each requested page.
+    // Include both sides of NPOT parent cuts and require the minimal set.
+    for(const auto extent:std::vector<std::pair<uint32_t,uint32_t>>{{256,128},{259,259},{1920,1080},{8192,8192}}) {
+        VtVariantLayout layout;CHECK(vt_build_layout(extent.first,extent.second,layout),"filter parents: valid layout");
+        bool coverage=true,minimal=true;
+        for(uint32_t mip=0;mip+1<layout.mip_count;++mip) {
+            const uint32_t w=std::max(layout.atlas_w>>mip,1u),h=std::max(layout.atlas_h>>mip,1u);
+            const uint32_t pw=std::max(w>>1,1u),ph=std::max(h>>1,1u);
+            for(uint32_t y=0;y<layout.page_h[mip];++y)for(uint32_t x=0;x<layout.page_w[mip];++x) {
+                VtPageKey parents[4];const auto count=vt_filter_parent_pages(layout,{mip,x,y},parents);
+                std::set<VtPageKey> actual(parents,parents+count),expected;
+                const double u0=double(x*128)/w,u1=double(std::min((x+1)*128,w))/w;
+                const double v0=double(y*128)/h,v1=double(std::min((y+1)*128,h))/h;
+                for(uint32_t py=0;py<layout.page_h[mip+1];++py)for(uint32_t px=0;px<layout.page_w[mip+1];++px)
+                    if(std::max(u0,double(px*128)/pw)<std::min(u1,double(std::min((px+1)*128,pw))/pw) &&
+                       std::max(v0,double(py*128)/ph)<std::min(v1,double(std::min((py+1)*128,ph))/ph))
